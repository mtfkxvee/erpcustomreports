#
# Cara install paling mudah (TANPA custom app):
# 1. Buka ERPNext → search "Report List" → New Report
# 2. Report Name: Multi Step Profit and Loss
# 3. Report Type: Script Report
# 4. Is Standard: No
# 5. Ref DocType: GL Entry
# 6. Save, lalu paste code Python ini di field "Script" (kalau muncul)
#    ATAU letakkan file ini di custom app sesuai path di atas.

import frappe
from frappe import _
from frappe.utils import flt, getdate
from erpnext.accounts.report.financial_statements import (
    get_period_list,
    get_data,
    get_columns,
)


def execute(filters=None):
    if not filters:
        filters = {}

    # ===== Setup periode =====
    period_list = get_period_list(
        filters.get("from_fiscal_year"),
        filters.get("to_fiscal_year"),
        filters.get("period_start_date"),
        filters.get("period_end_date"),
        filters.get("filter_based_on"),
        filters.get("periodicity", "Yearly"),
        company=filters.get("company"),
    )

    currency = filters.get("presentation_currency") or frappe.get_cached_value(
        "Company", filters.get("company"), "default_currency"
    )

    # ===== 1. Tarik data pendapatan (Income) =====
    # Kita pecah berdasarkan parent account: "Pendapatan Usaha" vs "Pendapatan Lain-Lain"
    income = get_data(
        filters.get("company"),
        "Income",
        "Credit",
        period_list,
        filters=filters,
        accumulated_values=filters.get("accumulated_values"),
        ignore_closing_entries=True,
        ignore_accumulated_values_for_fy=True,
    )

    # ===== 2. Tarik data HPP (Cost of Goods Sold) =====
    # Asumsi: akun HPP punya account_name yang mengandung "HPP" atau "Cost of Goods Sold"
    # atau parent account-nya specifically untuk HPP.
    # SESUAIKAN dengan struktur CoA-mu.
    expense = get_data(
        filters.get("company"),
        "Expense",
        "Debit",
        period_list,
        filters=filters,
        accumulated_values=filters.get("accumulated_values"),
        ignore_closing_entries=True,
        ignore_accumulated_values_for_fy=True,
    )

    # ===== 3. Pisahkan akun-akun berdasarkan klasifikasi =====
    operating_income = []      # Pendapatan Usaha (4-0000)
    other_income = []          # Pendapatan Lain-Lain (7-0000)
    cogs = []                  # HPP (5-0000)
    operating_expense = []     # Beban Operasional (6-0000)

    # Klasifikasi income berdasarkan account_number atau nama parent
    if income:
        for row in income:
            if not row:
                continue
            acc_number = (row.get("account_number") or "")
            acc_name = (row.get("account_name") or "").upper()
            
            # Pendapatan Lain-Lain: account_number dimulai "7" atau nama mengandung "LAIN"
            if acc_number.startswith("7") or "LAIN" in acc_name or "OTHER" in acc_name:
                other_income.append(row)
            else:
                operating_income.append(row)

    # Klasifikasi expense
    if expense:
        for row in expense:
            if not row:
                continue
            acc_number = (row.get("account_number") or "")
            acc_name = (row.get("account_name") or "").upper()
            
            # HPP: account_number dimulai "5" atau nama mengandung "HPP" / "COGS"
            if acc_number.startswith("5") or "HPP" in acc_name or "COGS" in acc_name or "COST OF GOODS" in acc_name:
                cogs.append(row)
            else:
                operating_expense.append(row)

    # ===== 4. Hitung total per kelompok per periode =====
    def total_per_period(rows, period_list):
        totals = {p.key: 0.0 for p in period_list}
        totals["total"] = 0.0
        for row in rows:
            if not row or row.get("is_group"):
                continue
            for p in period_list:
                totals[p.key] += flt(row.get(p.key, 0))
            totals["total"] += flt(row.get("total", 0))
        return totals

    op_income_total = total_per_period(operating_income, period_list)
    cogs_total = total_per_period(cogs, period_list)
    op_expense_total = total_per_period(operating_expense, period_list)
    other_income_total = total_per_period(other_income, period_list)

    # ===== 5. Susun output rows dengan struktur multi-step =====
    data = []

    # --- Section: Pendapatan Usaha ---
    data.append(_section_header("PENDAPATAN USAHA", period_list))
    data.extend(_clean_rows(operating_income))
    data.append(_subtotal_row("Total Pendapatan Usaha", op_income_total, period_list))
    data.append({})  # blank line

    # --- Section: HPP ---
    data.append(_section_header("HARGA POKOK PENJUALAN", period_list))
    data.extend(_clean_rows(cogs))
    data.append(_subtotal_row("Total HPP", cogs_total, period_list))
    data.append({})

    # --- GROSS PROFIT ---
    gross_profit = _calculate_gross_profit(op_income_total, cogs_total, period_list)
    data.append(_total_row("GROSS PROFIT (LABA KOTOR)", gross_profit, period_list, bold=True))
    data.append({})

    # --- Section: Beban Operasional ---
    data.append(_section_header("BEBAN OPERASIONAL", period_list))
    data.extend(_clean_rows(operating_expense))
    data.append(_subtotal_row("Total Beban Operasional", op_expense_total, period_list))
    data.append({})

    # --- OPERATING PROFIT ---
    op_profit = _subtract(gross_profit, op_expense_total, period_list)
    data.append(_total_row("OPERATING PROFIT (LABA USAHA)", op_profit, period_list, bold=True))
    data.append({})

    # --- Section: Pendapatan Lain-Lain ---
    if other_income:
        data.append(_section_header("PENDAPATAN LAIN-LAIN", period_list))
        data.extend(_clean_rows(other_income))
        data.append(_subtotal_row("Total Pendapatan Lain-Lain", other_income_total, period_list))
        data.append({})

    # --- NET PROFIT ---
    net_profit = _add(op_profit, other_income_total, period_list)
    data.append(_total_row("NET PROFIT (LABA BERSIH)", net_profit, period_list, bold=True))

    # ===== 6. Columns =====
    columns = get_columns("Profit and Loss", period_list, filters=filters, company=filters.get("company"))

    # ===== 7. Chart data =====
    chart = _get_chart_data(
        period_list,
        op_income_total,
        cogs_total,
        gross_profit,
        op_expense_total,
        op_profit,
        other_income_total,
        net_profit,
        currency,
    )

    # ===== 8. Report summary cards =====
    report_summary = _get_summary(
        op_income_total, gross_profit, op_profit, net_profit, currency
    )

    return columns, data, None, chart, report_summary


# =========================================================
# Helper functions
# =========================================================

def _section_header(label, period_list):
    row = {
        "account_name": label,
        "account": label,
        "indent": 0,
        "has_value": False,
        "is_group_header": True,
    }
    for p in period_list:
        row[p.key] = ""
    row["total"] = ""
    return row


def _subtotal_row(label, totals, period_list):
    row = {
        "account_name": label,
        "account": label,
        "indent": 0.5,
        "has_value": True,
        "is_subtotal": True,
    }
    for p in period_list:
        row[p.key] = totals.get(p.key, 0)
    row["total"] = totals.get("total", 0)
    return row


def _total_row(label, totals, period_list, bold=False):
    row = {
        "account_name": label,
        "account": label,
        "indent": 0,
        "has_value": True,
        "is_total": True,
        "bold": bold,
    }
    for p in period_list:
        row[p.key] = totals.get(p.key, 0)
    row["total"] = totals.get("total", 0)
    return row


def _clean_rows(rows):
    """Bersihkan rows dari group rows yang berlebihan, sisain leaf accounts saja"""
    cleaned = []
    for row in rows:
        if not row:
            continue
        # skip pure group accounts (no transactions) untuk laporan multi-step ringkas
        # tapi tetap include sebagai informasi
        cleaned.append(row)
    return cleaned


def _calculate_gross_profit(income_totals, cogs_totals, period_list):
    result = {}
    for p in period_list:
        result[p.key] = flt(income_totals.get(p.key, 0)) - flt(cogs_totals.get(p.key, 0))
    result["total"] = flt(income_totals.get("total", 0)) - flt(cogs_totals.get("total", 0))
    return result


def _subtract(a, b, period_list):
    result = {}
    for p in period_list:
        result[p.key] = flt(a.get(p.key, 0)) - flt(b.get(p.key, 0))
    result["total"] = flt(a.get("total", 0)) - flt(b.get("total", 0))
    return result


def _add(a, b, period_list):
    result = {}
    for p in period_list:
        result[p.key] = flt(a.get(p.key, 0)) + flt(b.get(p.key, 0))
    result["total"] = flt(a.get("total", 0)) + flt(b.get("total", 0))
    return result


def _get_chart_data(period_list, op_income, cogs, gross_profit,
                     op_expense, op_profit, other_income, net_profit, currency):
    labels = [p.label for p in period_list]
    
    return {
        "data": {
            "labels": labels,
            "datasets": [
                {
                    "name": _("Pendapatan Usaha"),
                    "values": [op_income.get(p.key, 0) for p in period_list],
                },
                {
                    "name": _("Gross Profit"),
                    "values": [gross_profit.get(p.key, 0) for p in period_list],
                },
                {
                    "name": _("Operating Profit"),
                    "values": [op_profit.get(p.key, 0) for p in period_list],
                },
                {
                    "name": _("Net Profit"),
                    "values": [net_profit.get(p.key, 0) for p in period_list],
                },
            ],
        },
        "type": "bar",
        "fieldtype": "Currency",
        "options": {"currency": currency},
    }


def _get_summary(op_income, gross_profit, op_profit, net_profit, currency):
    op_income_total = op_income.get("total", 0)
    gp_margin = (gross_profit.get("total", 0) / op_income_total * 100) if op_income_total else 0
    op_margin = (op_profit.get("total", 0) / op_income_total * 100) if op_income_total else 0
    net_margin = (net_profit.get("total", 0) / op_income_total * 100) if op_income_total else 0

    return [
        {
            "value": op_income_total,
            "label": _("Pendapatan Usaha"),
            "datatype": "Currency",
            "currency": currency,
        },
        {
            "value": gross_profit.get("total", 0),
            "label": _("Gross Profit") + f" ({gp_margin:.1f}%)",
            "indicator": "Green" if gross_profit.get("total", 0) >= 0 else "Red",
            "datatype": "Currency",
            "currency": currency,
        },
        {
            "value": op_profit.get("total", 0),
            "label": _("Operating Profit") + f" ({op_margin:.1f}%)",
            "indicator": "Green" if op_profit.get("total", 0) >= 0 else "Red",
            "datatype": "Currency",
            "currency": currency,
        },
        {
            "value": net_profit.get("total", 0),
            "label": _("Net Profit") + f" ({net_margin:.1f}%)",
            "indicator": "Green" if net_profit.get("total", 0) >= 0 else "Red",
            "datatype": "Currency",
            "currency": currency,
        },
    ]
