[
  {
    "doctype": "Custom Field",
    "dt": "Payment Entry",
    "fieldname": "is_cheque_payment",
    "label": "Is Cheque/Giro Payment",
    "fieldtype": "Check",
    "insert_after": "mode_of_payment",
    "read_only": 1,
    "no_copy": 1
  },
  {
    "doctype": "Custom Field",
    "dt": "Payment Entry",
    "fieldname": "cheque_status",
    "label": "Cheque Status",
    "fieldtype": "Select",
    "options": "\nPending\nCleared\nBounced",
    "insert_after": "is_cheque_payment",
    "read_only": 1,
    "no_copy": 1,
    "in_list_view": 1,
    "in_standard_filter": 1
  },
  {
    "doctype": "Custom Field",
    "dt": "Payment Entry",
    "fieldname": "cheque_clearing_je",
    "label": "Clearing Journal Entry",
    "fieldtype": "Link",
    "options": "Journal Entry",
    "insert_after": "cheque_status",
    "read_only": 1,
    "no_copy": 1
  },
  {
    "doctype": "Custom Field",
    "dt": "Driver Activity",
    "fieldname": "kendaraan",
    "label": "Kendaraan",
    "fieldtype": "Link",
    "options": "Vehicle",
    "insert_after": "tipe",
    "in_list_view": 1,
    "in_standard_filter": 1
  },
  {
    "doctype": "Custom Field",
    "dt": "Driver Activity",
    "fieldname": "kategori",
    "label": "Kategori",
    "fieldtype": "Select",
    "options": "\nBBM\nToll\nParkir\nMakan\nLainnya",
    "insert_after": "kendaraan",
    "in_list_view": 1,
    "in_standard_filter": 1,
    "depends_on": "eval:doc.tipe==\"Pengeluaran\""
  },
  {
    "doctype": "Custom Field",
    "dt": "Driver Activity",
    "fieldname": "km",
    "label": "KM",
    "fieldtype": "Int",
    "insert_after": "kategori",
    "depends_on": "eval:doc.tipe==\"Pengeluaran\" && doc.kategori==\"BBM\""
  },
  {
    "doctype": "Custom Field",
    "dt": "Driver Activity",
    "fieldname": "jenis_kendala",
    "label": "Jenis Kendala",
    "fieldtype": "Select",
    "options": "\nKendaraan bermasalah\nAkses lokasi terhalang\nBarang rusak\nLainnya",
    "insert_after": "km",
    "in_standard_filter": 1,
    "depends_on": "eval:doc.tipe==\"Kendala\""
  }
]