[
  {
    "doctype": "Custom Field",
    "dt": "Payment Entry",
    "fieldname": "is_cheque_payment",
    "label": "Is Cheque/Giro Payment",
    "fieldtype": "Check",
    "insert_after": "mode_of_payment",
    "read_only": 1,
    "no_copy": 1
  },
  {
    "doctype": "Custom Field",
    "dt": "Payment Entry",
    "fieldname": "cheque_status",
    "label": "Cheque Status",
    "fieldtype": "Select",
    "options": "\nPending\nCleared\nBounced",
    "insert_after": "is_cheque_payment",
    "read_only": 1,
    "no_copy": 1,
    "in_list_view": 1,
    "in_standard_filter": 1
  },
  {
    "doctype": "Custom Field",
    "dt": "Payment Entry",
    "fieldname": "cheque_clearing_je",
    "label": "Clearing Journal Entry",
    "fieldtype": "Link",
    "options": "Journal Entry",
    "insert_after": "cheque_status",
    "read_only": 1,
    "no_copy": 1
  },
  {
    "doctype": "Custom Field",
    "dt": "Driver Activity",
    "fieldname": "kendaraan",
    "label": "Kendaraan",
    "fieldtype": "Link",
    "options": "Vehicle",
    "insert_after": "tipe",
    "in_list_view": 1,
    "in_standard_filter": 1
  },
  {
    "doctype": "Custom Field",
    "dt": "Driver Activity",
    "fieldname": "kategori",
    "label": "Kategori",
    "fieldtype": "Select",
    "options": "\nBBM\nToll\nParkir\nMakan\nLainnya",
    "insert_after": "kendaraan",
    "in_list_view": 1,
    "in_standard_filter": 1,
    "depends_on": "eval:doc.tipe==\"Pengeluaran\""
  },
  {
    "doctype": "Custom Field",
    "dt": "Driver Activity",
    "fieldname": "km",
    "label": "KM",
    "fieldtype": "Int",
    "insert_after": "kategori",
    "depends_on": "eval:doc.tipe==\"Pengeluaran\" && doc.kategori==\"BBM\""
  },
  {
    "doctype": "Custom Field",
    "dt": "Driver Activity",
    "fieldname": "jenis_kendala",
    "label": "Jenis Kendala",
    "fieldtype": "Select",
    "options": "\nKendaraan bermasalah\nAkses lokasi terhalang\nBarang rusak\nLainnya",
    "insert_after": "km",
    "in_standard_filter": 1,
    "depends_on": "eval:doc.tipe==\"Kendala\""
  },
  {
    "doctype": "Custom Field",
    "dt": "Stock Entry Detail",
    "fieldname": "from_shelving",
    "label": "Dari Shelving",
    "fieldtype": "Link",
    "options": "Shelving",
    "insert_after": "s_warehouse",
    "in_list_view": 1,
    "no_copy": 1,
    "allow_on_submit": 0,
    "description": "Kosong = dikurangi otomatis dari shelving berprioritas terkecil"
  },
  {
    "doctype": "Custom Field",
    "dt": "Stock Entry Detail",
    "fieldname": "to_shelving",
    "label": "Ke Shelving",
    "fieldtype": "Link",
    "options": "Shelving",
    "insert_after": "t_warehouse",
    "in_list_view": 1,
    "no_copy": 1,
    "allow_on_submit": 0,
    "description": "Wajib diisi bila warehouse tujuan memakai shelving"
  },
  {
    "doctype": "Custom Field",
    "dt": "Warehouse",
    "fieldname": "use_shelving",
    "label": "Pakai Shelving",
    "fieldtype": "Check",
    "insert_after": "is_group",
    "depends_on": "eval:!doc.is_group",
    "no_copy": 1,
    "description": "Centang hanya untuk warehouse tempat barang disusun di rak (mis. XSM 1). Warehouse penerimaan (Selling Area) dan parent group jangan dicentang."
  }
]
