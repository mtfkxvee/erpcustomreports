    }


# --- Ditambahkan: Monthly Sales Achievement vs Target, SUDAH dikurangi retur
# produk & potongan - All/Per Department/Per Outlet (BUKAN per kategori),
# dibandingkan bulan sebelumnya (MoM) & bulan yg sama tahun sebelumnya (YoY).
# Sumbernya sama dgn get_weekly_margin/get_weekly_sales_net_achievement (GL
# Entry akun "Penjualan"/"Retur Penjualan"/4 potongan), cuma rentang tanggal-
# nya per BULAN, bukan per minggu - divalidasi thd formula file "SALES CLEAR
# ACHV VS TARGET MoM YoY.xlsx" (Sheet4 "SALES ACHV" = persis field sales_retur
# yg sama dgn Weekly Margin).
#
# CATATAN: krn data live Sales Invoice/GL Entry baru ada sejak akhir April
# 2026, perbandingan "vs tahun lalu" (YoY) TERPAKSA pakai sales histori mentah
# (blm dikurangi retur/potongan scr presisi spt bulan berjalan) - itu satu2nya
# data yg tersedia utk periode itu. KMT & MBG jg sales apa adanya (data manual,
# tdk py breakdown retur/potongan sama sekali).
def _month_range(year, month):
    start = frappe.utils.getdate(f"{year}-{month:02d}-01")
    days = calendar.monthrange(year, month)[1]
    return start, start.replace(day=days)


@frappe.whitelist()
def get_monthly_sales_net_achievement(department="FASHION", month=None, year=None):
    today = frappe.utils.getdate(frappe.utils.today())
    target_month = int(month) if month else today.month
    target_year = int(year) if year else today.year
    month_start, month_full_end = _month_range(target_year, target_month)
    is_current_month = (target_year, target_month) == (today.year, today.month)
    as_of = today if is_current_month else month_full_end

    bulan_label = _BULAN_ID[target_month - 1]
    day_cutoff = as_of.day

    m1 = target_month - 1 if target_month > 1 else 12
    y1 = target_year if target_month > 1 else target_year - 1
    lm_start, _ = _month_range(y1, m1)
    lm_end = lm_start.replace(day=min(day_cutoff, calendar.monthrange(y1, m1)[1]))

    last_year = target_year - 1
    ly_start, _ = _month_range(last_year, target_month)
    ly_end = ly_start.replace(day=min(day_cutoff, calendar.monthrange(last_year, target_month)[1]))

    targets = _target_by_outlet(bulan_label)

    def net_amt(gl):
        # "SALES ACHV" versi laporan BULANAN ini = SALES-RETUR + Promo + RAFAKSI
        # (beda dari get_weekly_margin yg cuma +Promo) - divalidasi persis ke
        # rupiah thd file "SALES CLEAR ACHV VS TARGET MoM YoY.xlsx" (Cikiray &
        # Pasar Agustus, exact match stlh ditambah RAFAKSI juga).
        m = _margin_row("x", "x", gl, 0)
        return m["sales_retur"] + m["promo"] + m["rafaksi_discount"]

    def make_row(outlet_key, label, target_outlets, cur_net, lm_net, ly_net, note=None):
        target = sum(targets.get(o, 0) for o in target_outlets)
        achv = round(cur_net / target * 100, 2) if target else None
        row = {
            "outlet": outlet_key, "label": label, "target": target,
            "sales_net": cur_net, "achv_vs_target_pct": achv,
            "sales_net_last_month": lm_net, "growth_vs_last_month_pct": _pct_change(cur_net, lm_net),
            "sales_net_last_year": ly_net, "growth_vs_last_year_pct": _pct_change(cur_net, ly_net),
        }
        if note:
            row["note"] = note
        return row

    dept = department.upper()

    if dept == "HO":
        kmt_mbg_cur = _sales_by_kmt_mbg(month_start, as_of)
        kmt_mbg_lm = _sales_by_kmt_mbg(lm_start, lm_end)
        kmt_ly = _kmt_only(ly_start, ly_end)  # MBG blm py histori tahun lalu

        gl_xsl_cur = _gl_deductions_by_outlet(month_start, as_of, ["XSL"])
        gl_xsl_lm = _gl_deductions_by_outlet(lm_start, lm_end, ["XSL"])
        hist_xsl_ly = _sales_by_outlet_history(ly_start, ly_end)

        note_manual = "Sales KMT/MBG data manual, blm ada breakdown retur/potongan - sales_net = sales apa adanya."
        rows = [
            make_row("KMT", "Kemitraan", ["KMT"],
                     kmt_mbg_cur.get("KMT", {}).get("sales", 0), kmt_mbg_lm.get("KMT", {}).get("sales", 0),
                     kmt_ly.get("KMT", {}).get("sales", 0), note_manual),
            make_row("XSL", "Mini Soccer", ["XSL"],
                     net_amt(gl_xsl_cur.get("XSL", {})), net_amt(gl_xsl_lm.get("XSL", {})),
                     hist_xsl_ly.get("XSL", {}).get("sales", 0)),
            make_row("MBG", "MBG", ["MBG"],
                     kmt_mbg_cur.get("MBG", {}).get("sales", 0), kmt_mbg_lm.get("MBG", {}).get("sales", 0),
                     0, note_manual),
        ]
        return {
            "department": dept, "bulan": bulan_label, "tahun": target_year,
            "period_start": str(month_start), "period_end": str(as_of), "rows": rows,
        }

    outlets = _MARGIN_FASHION_OUTLETS if dept == "FASHION" else (
        _MARGIN_FMCG_OUTLETS if dept == "FMCG" else [dept] if dept in _OUTLET_COST_CENTER else []
    )

    gl_cur = _gl_deductions_by_outlet(month_start, as_of, outlets)
    gl_lm = _gl_deductions_by_outlet(lm_start, lm_end, outlets)
    hist_ly = _sales_by_outlet_history(ly_start, ly_end)

    def outlet_net(o):
        return net_amt(gl_cur.get(o, {})), net_amt(gl_lm.get(o, {})), hist_ly.get(o, {}).get("sales", 0)

    def combined_net(members):
        gl_sum = {acc: sum(gl_cur.get(o, {}).get(acc, 0) for o in members) for acc in _GL_MARGIN_ACCOUNTS}
        gl_lm_sum = {acc: sum(gl_lm.get(o, {}).get(acc, 0) for o in members) for acc in _GL_MARGIN_ACCOUNTS}
        ly_sum = sum(hist_ly.get(o, {}).get("sales", 0) for o in members)
        return net_amt(gl_sum), net_amt(gl_lm_sum), ly_sum

    rows = []
    for o in outlets:
        cur_net, lm_net, ly_net = outlet_net(o)
        rows.append(make_row(o, _OUTLET_LABELS.get(o, o), [o], cur_net, lm_net, ly_net))
        if o in _MARGIN_COMBINE_AFTER:
            label, members = _MARGIN_COMBINE_AFTER[o]
            cur_net, lm_net, ly_net = combined_net(members)
            rows.append(make_row("+".join(members), label, members, cur_net, lm_net, ly_net))

    cur_net, lm_net, ly_net = combined_net(outlets)
    rows.append(make_row("TOTAL", "Total", outlets, cur_net, lm_net, ly_net))

    return {
        "department": dept, "bulan": bulan_label, "tahun": target_year,
        "period_start": str(month_start), "period_end": str(as_of), "rows": rows,
    }


# --- Ditambahkan: Monthly VISITOR TC AC Achievement, All/Per Department/Per
# Outlet, vs bulan sebelumnya (MoM) & tahun sebelumnya (YoY). EXCLUDE
# MBG/KMT/XSL (sesuai nama sheet file referensi "EXC MBG,KMT,XSL" - visitor
# fisik toko tdk relevan utk 3 outlet itu).
#
# CATATAN: TARGET VISITOR sudah ada (doctype baru "Outlet Visitor Target",
# diimport dari file "TARGET PROGRAM MARKETING 2026" sheet "TARGET VISITOR").
# TARGET TC & TARGET AC msh BELUM ada sumbernya sama sekali (beda dari target
# SALES yg sudah ada di 'Sales Target Monthly'). Field 'visitor' di POS
# Closing Shift jg baru aktif terisi mulai Agustus 2026, jadi perbandingan
# VISITOR vs tahun lalu (2025) kemungkinan besar bakal 0/kosong krn datanya
# blm ada di periode itu.
def _target_visitor_by_outlet(bulan_label):
    rows = frappe.db.sql("""
        SELECT outlet, target_visitor FROM `tabOutlet Visitor Target` WHERE bulan = %s
    """, (bulan_label,), as_dict=True)
    return {r["outlet"]: r["target_visitor"] or 0 for r in rows}


def _target_tc_ac_by_outlet(bulan_label):
    # TARGET TC & AC: FMCG lengkap 12 bulan (dari "Dashboard FMCG" sheet
    # "Target Transaksi"/"Target Basket Size"), FASHION baru ada utk
    # Juli & Agustus 2026 saja (dari file "VISITOR, TC, AC ACHV VS TARGET") -
    # bulan lain utk FASHION msh kosong sampai ada data tambahan.
    rows = frappe.db.sql("""
        SELECT outlet, target_tc, target_ac FROM `tabOutlet TC AC Target` WHERE bulan = %s
    """, (bulan_label,), as_dict=True)
    return {r["outlet"]: {"tc": r["target_tc"] or 0, "ac": r["target_ac"] or 0} for r in rows}


@frappe.whitelist()
def get_monthly_visitor_achievement(department="FASHION", month=None, year=None):
    today = frappe.utils.getdate(frappe.utils.today())
    target_month = int(month) if month else today.month
    target_year = int(year) if year else today.year
    month_start, month_full_end = _month_range(target_year, target_month)
    is_current_month = (target_year, target_month) == (today.year, today.month)
    as_of = today if is_current_month else month_full_end
    day_cutoff = as_of.day

    m1 = target_month - 1 if target_month > 1 else 12
    y1 = target_year if target_month > 1 else target_year - 1
    lm_start, _ = _month_range(y1, m1)
    lm_end = lm_start.replace(day=min(day_cutoff, calendar.monthrange(y1, m1)[1]))

    last_year = target_year - 1
    ly_start, _ = _month_range(last_year, target_month)
    ly_end = ly_start.replace(day=min(day_cutoff, calendar.monthrange(last_year, target_month)[1]))

    dept = department.upper()
    outlets = _MARGIN_FASHION_OUTLETS if dept == "FASHION" else (
        _MARGIN_FMCG_OUTLETS if dept == "FMCG" else [dept]
    )

    sales_cur = _sales_by_outlet(month_start, as_of)
    sales_lm = _sales_by_outlet(lm_start, lm_end)
    sales_ly = _sales_by_outlet_history(ly_start, ly_end)
    visitor_cur = _visitor_by_outlet(month_start, as_of)
    visitor_lm = _visitor_by_outlet(lm_start, lm_end)
    visitor_ly = _visitor_by_outlet(ly_start, ly_end)
    targets_visitor = _target_visitor_by_outlet(_BULAN_ID[target_month - 1])
    targets_tc_ac = _target_tc_ac_by_outlet(_BULAN_ID[target_month - 1])

    def metrics(outlets_list):
        tc = sum(sales_cur.get(o, {}).get("trx", 0) for o in outlets_list)
        sales = sum(sales_cur.get(o, {}).get("sales", 0) for o in outlets_list)
        visitor = sum(visitor_cur.get(o, 0) for o in outlets_list)
        lm_tc = sum(sales_lm.get(o, {}).get("trx", 0) for o in outlets_list)
        lm_sales = sum(sales_lm.get(o, {}).get("sales", 0) for o in outlets_list)
        lm_visitor = sum(visitor_lm.get(o, 0) for o in outlets_list)
        ly_tc = sum(sales_ly.get(o, {}).get("trx", 0) for o in outlets_list)
        ly_sales = sum(sales_ly.get(o, {}).get("sales", 0) for o in outlets_list)
        ly_visitor = sum(visitor_ly.get(o, 0) for o in outlets_list)
        target_visitor = sum(targets_visitor.get(o, 0) for o in outlets_list)
        target_tc = sum(targets_tc_ac.get(o, {}).get("tc", 0) for o in outlets_list)
        target_ac_vals = [targets_tc_ac.get(o, {}).get("ac", 0) for o in outlets_list if targets_tc_ac.get(o, {}).get("ac")]
        target_ac = round(sum(target_ac_vals) / len(target_ac_vals), 2) if target_ac_vals else 0
        ac = _ac(sales, tc)
        return {
            "tc": tc, "sales": sales, "ac": ac, "visitor": visitor,
            "achievement_pct": round(tc / visitor * 100, 2) if visitor else None,
            "target_visitor": target_visitor,
            "achv_visitor_vs_target_pct": round(visitor / target_visitor * 100, 2) if target_visitor else None,
            "target_tc": target_tc, "achv_tc_vs_target_pct": round(tc / target_tc * 100, 2) if target_tc else None,
            "target_ac": target_ac, "achv_ac_vs_target_pct": round(ac / target_ac * 100, 2) if (target_ac and ac) else None,
            "growth_tc_pct": _pct_change(tc, lm_tc), "growth_sales_pct": _pct_change(sales, lm_sales),
            "growth_ac_pct": _pct_change(ac, _ac(lm_sales, lm_tc)),
            "growth_visitor_pct": _pct_change(visitor, lm_visitor),
            "tc_last_month": lm_tc, "sales_last_month": lm_sales, "visitor_last_month": lm_visitor,
            "vs_last_year_tc_pct": _pct_change(tc, ly_tc), "vs_last_year_sales_pct": _pct_change(sales, ly_sales),
            "vs_last_year_visitor_pct": _pct_change(visitor, ly_visitor),
            "tc_last_year": ly_tc, "sales_last_year": ly_sales, "visitor_last_year": ly_visitor,
        }

    rows = []
    for o in outlets:
        row = {"outlet": o, "label": _OUTLET_LABELS.get(o, o)}
        row.update(metrics([o]))
        rows.append(row)
    total_row = {"outlet": "TOTAL", "label": "Total"}
    total_row.update(metrics(outlets))
    rows.append(total_row)

    return {
        "department": dept, "bulan": _BULAN_ID[target_month - 1], "tahun": target_year,
        "period_start": str(month_start), "period_end": str(as_of), "rows": rows,
    }


