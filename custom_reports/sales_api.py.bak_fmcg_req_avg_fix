# minggu (konvensi minggu SAMA spt get_weekly_sales_achievement: blok
# 1-7/8-14/15-21/22-akhir bulan). Sumbernya doctype standar ERPNext "POS
# Closing Shift" field "visitor" (Int) - TERNYATA ADA & terisi konsisten sejak
# Agustus 2026 (sebelumnya dikira tdk ada di ERP sama sekali - baru ketemu
# krn ini field bawaan standar, bukan custom field, jadi kelewat di pencarian
# custom field sebelumnya). Divalidasi thd "SALES REPORT HO AGT 2026.xlsx"
# kolom VISITOR - 11 dari 14 outlet exact match, sisanya beda tipis (~1-7%,
# wajar krn data terus diedit setelah file dibuat).
_POS_PROFILE_TO_OUTLET = {
    "HCW": "HCW", "MNR": "MNR", "OCW": "OCW", "PSR": "PSR", "TASMU": "TASMU",
    "UIN": "UIN", "XCR": "XCR", "XCW": "XCW", "XJB": "XJB", "XSHA FURNITURE JB": "XJB",
    "XMJ": "XMJ", "XPH": "XPH", "XPY": "XPY", "XSC": "XSC", "XSC-OL": "XSC-OL",
    "XSL": "XSL", "XSM": "XSM", "XSM GROW": "XSMGROW", "XSP": "XSP", "XSP-OL": "XSP-OL",
    "XTJ": "XTJ", "XWP": "XWP", "KMT": "KMT",
}


def _visitor_by_outlet(start_date, end_date):
    rows = frappe.db.sql("""
        SELECT pos_profile, SUM(visitor) AS total_visitor
        FROM `tabPOS Closing Shift`
        WHERE posting_date BETWEEN %s AND %s
        GROUP BY pos_profile
    """, (start_date, end_date), as_dict=True)
    result = {}
    for r in rows:
        outlet = _POS_PROFILE_TO_OUTLET.get(r["pos_profile"])
        if not outlet:
            continue
        result[outlet] = result.get(outlet, 0) + (r["total_visitor"] or 0)
    return result


def _month_visitor(year, month, outlets):
    weeks = []
    for s, e in _week_bounds(year, month):
        start_date = frappe.utils.getdate(f"{year}-{month:02d}-{s:02d}")
        end_date = frappe.utils.getdate(f"{year}-{month:02d}-{e:02d}")
        v = _visitor_by_outlet(start_date, end_date)
        weeks.append({o: v.get(o, 0) for o in outlets})
    return weeks


@frappe.whitelist()
def get_weekly_visitor_achievement(month=None, year=None):
    today = frappe.utils.getdate(frappe.utils.today())
    month = int(month) if month else today.month
    year = int(year) if year else today.year

    cur = _month_tc_sales(year, month, _WEEKLY_OUTLETS)
    visitor = _month_visitor(year, month, _WEEKLY_OUTLETS)

    def week_row(i, outlet):
        c = cur[i].get(outlet, {"sales": 0, "trx": 0})
        tc, sales = c["trx"], c["sales"]
        ac = _ac(sales, tc)
        v = visitor[i].get(outlet, 0)
        achv_pct = round(tc / v * 100, 2) if v else None
        return tc, sales, ac, v, achv_pct

    def week_metrics(outlet):
        weeks_out = []
        prev = None
        for i in range(4):
            tc, sales, ac, v, achv_pct = week_row(i, outlet)
            weeks_out.append({
                "week": i + 1, "tc": tc, "sales": sales, "ac": ac,
                "visitor": v, "achievement_pct": achv_pct,
                "growth_tc_pct": _pct(tc, prev["tc"]) if prev else None,
                "growth_sales_pct": _pct(sales, prev["sales"]) if prev else None,
                "growth_ac_pct": _pct(ac, prev["ac"]) if prev else None,
                "growth_visitor_pct": _pct(v, prev["visitor"]) if prev else None,
                "growth_achievement_pct": _pct(achv_pct, prev["achievement_pct"]) if prev else None,
            })
            prev = {"tc": tc, "sales": sales, "ac": ac, "visitor": v, "achievement_pct": achv_pct}
        return {"outlet": outlet, "label": _OUTLET_LABELS.get(outlet, outlet), "weeks": weeks_out}

    def group_metrics(label, outlets):
        weeks_out = []
        prev = None
        for i in range(4):
            tc = sum(cur[i].get(o, {"trx": 0})["trx"] for o in outlets)
            sales = sum(cur[i].get(o, {"sales": 0})["sales"] for o in outlets)
            ac = _ac(sales, tc)
            v = sum(visitor[i].get(o, 0) for o in outlets)
            achv_pct = round(tc / v * 100, 2) if v else None
            weeks_out.append({
                "week": i + 1, "tc": tc, "sales": sales, "ac": ac,
                "visitor": v, "achievement_pct": achv_pct,
                "growth_tc_pct": _pct(tc, prev["tc"]) if prev else None,
                "growth_sales_pct": _pct(sales, prev["sales"]) if prev else None,
                "growth_ac_pct": _pct(ac, prev["ac"]) if prev else None,
                "growth_visitor_pct": _pct(v, prev["visitor"]) if prev else None,
                "growth_achievement_pct": _pct(achv_pct, prev["achievement_pct"]) if prev else None,
            })
            prev = {"tc": tc, "sales": sales, "ac": ac, "visitor": v, "achievement_pct": achv_pct}
        return {"outlet": label, "label": label, "weeks": weeks_out}

    fashion_outlets = _FASHION_OUTLETS
    fmcg_outlets = [o for o in _FMCG_OUTLETS if o != "KMT"]

    fashion_rows = [week_metrics(o) for o in fashion_outlets]
    fashion_rows.append(group_metrics("FASHION & H S", fashion_outlets))

    fmcg_rows = [week_metrics(o) for o in fmcg_outlets]
    fmcg_rows.append(group_metrics("FMCG", fmcg_outlets))

    ho_rows = [
        week_metrics(_MINI_SOCCER_OUTLET),
        week_metrics("KMT"),
        week_metrics(_MBG_OUTLET),
    ]

    holding_row = group_metrics("HOLDING", _WEEKLY_OUTLETS)

    return {
        "bulan": f"{year}-{month:02d}",
        "week_bounds": [{"week": i + 1, "start": s, "end": e} for i, (s, e) in enumerate(_week_bounds(year, month))],
        "fashion": fashion_rows,
        "fmcg": fmcg_rows,
        "ho": ho_rows,
        "holding": holding_row,
    }


# --- Ditambahkan: Kontribusi Sales per KATEGORI PRODUK (item_group), per
# departemen, dibandingkan minggu sebelumnya (bukan per outlet spt laporan lain
# - ini breakdown per kategori barang, mis. BEVERAGE/SNACK/dll).
# URL: /api/method/custom_reports.sales_api.get_kontribusi_sales_category?department=FASHION&as_of_date=YYYY-MM-DD
#
# CATATAN: tabel child 'Sales Invoice Item' tidak bisa diakses via REST list
# API biasa (Frappe blok akses child table di luar konteks parent-nya) - jadi
# HARUS lewat SQL server-side spt ini, bukan via client REST.
# item_group yg dipakai adalah snapshot pada saat invoice dibuat (tersimpan di
# baris Sales Invoice Item itu sendiri), BUKAN item_group Item master saat ini
# - supaya laporan historis tetap konsisten walau ada barang yg direkategori
# ulang di kemudian hari.
# MBG tidak disertakan (sama spt laporan lain - outlet ini tidak py Sales
# Invoice di ERP sama sekali, datanya cuma ada di luar ERP).

def _category_sales(start_date, end_date, outlets):
    # Kategori "TOPUP" di-exclude - mekanisme voucher/saldo (harga Rp1/unit,
    # qty sangat besar), bukan barang dagangan beneran, jadi tdk relevan utk
    # laporan kontribusi sales per kategori produk.
    #
    # Di-ROLLUP ke PARENT item_group (bukan leaf item_group mentah) - divalidasi
    # thd file referensi "KONTRIBUSI SALES CATEGORY W4 VS W3.xlsx": leaf
    # item_group ada 347+ (terlalu granular, mis. "ACNE CARE"), sementara
    # laporan Excel cuma ~56-59 kategori yaitu level PARENT-nya (mis. "ACNE
    # CARE" & sejenisnya digabung jadi "FACIAL CARE", "BABY BATH & HYGIENE"
    # dkk digabung jadi "ACC BABY") - 51 dari 56 nama kategori Excel cocok
    # persis setelah rollup ini.
    if not outlets:
        return {}
    placeholders = ", ".join(["%s"] * len(outlets))
    rows = frappe.db.sql(f"""
        SELECT COALESCE(ig.parent_item_group, sii.item_group, '(Tanpa Kategori)') AS category,
               SUM(sii.qty) AS qty,
               SUM(sii.amount) AS amount
        FROM `tabSales Invoice Item` sii
        JOIN `tabSales Invoice` si ON si.name = sii.parent
        LEFT JOIN `tabItem Group` ig ON ig.name = sii.item_group
        WHERE si.docstatus = 1 AND si.is_return = 0
          AND si.posting_date BETWEEN %s AND %s
          AND si.custom_outlet IN ({placeholders})
          AND sii.item_group != 'TOPUP'
        GROUP BY COALESCE(ig.parent_item_group, sii.item_group, '(Tanpa Kategori)')
    """, [start_date, end_date] + list(outlets), as_dict=True)
    return {r["category"]: {"qty": r["qty"] or 0, "amount": r["amount"] or 0} for r in rows}


_KATEGORI_DEPT_OUTLETS = {
    "FASHION": _FASHION_OUTLETS,
    "FMCG": [o for o in _FMCG_OUTLETS if o != "KMT"],
    "XSL": [_MINI_SOCCER_OUTLET],
}


@frappe.whitelist()
def get_kontribusi_sales_category(department="FASHION", as_of_date=None):
    as_of = frappe.utils.getdate(as_of_date or frappe.utils.today())
    year, month = as_of.year, as_of.month
    bounds = _week_bounds(year, month)

    cur_week_idx = 3
    for i, (s, e) in enumerate(bounds):
        if s <= as_of.day <= e:
            cur_week_idx = i
            break

    def week_range(idx):
        if idx < 0:
            prev_month = month - 1 if month > 1 else 12
            prev_year = year if month > 1 else year - 1
            prev_bounds = _week_bounds(prev_year, prev_month)
            s, e = prev_bounds[-1]
            return (frappe.utils.getdate(f"{prev_year}-{prev_month:02d}-{s:02d}"),
                    frappe.utils.getdate(f"{prev_year}-{prev_month:02d}-{e:02d}"))
        s, e = bounds[idx]
        return (frappe.utils.getdate(f"{year}-{month:02d}-{s:02d}"),
                frappe.utils.getdate(f"{year}-{month:02d}-{e:02d}"))

    cur_start, cur_end = week_range(cur_week_idx)
    prev_start, prev_end = week_range(cur_week_idx - 1)

    outlets = _KATEGORI_DEPT_OUTLETS.get(department.upper(), [])
    cur_data = _category_sales(cur_start, cur_end, outlets)
    prev_data = _category_sales(prev_start, prev_end, outlets)

    cur_total = sum(v["amount"] for v in cur_data.values())
    prev_total = sum(v["amount"] for v in prev_data.values())

    rows = []
    for cat in sorted(set(cur_data) | set(prev_data)):
        c = cur_data.get(cat, {"qty": 0, "amount": 0})
        p = prev_data.get(cat, {"qty": 0, "amount": 0})
        c_kontribusi = (c["amount"] / cur_total) if cur_total else 0
        p_kontribusi = (p["amount"] / prev_total) if prev_total else 0
        growth = (c_kontribusi / p_kontribusi - 1) if p_kontribusi else 0
        rows.append({
            "category": cat,
            "week_current": {"qty": c["qty"], "sales": c["amount"], "kontribusi_pct": round(c_kontribusi * 100, 6)},
            "week_previous": {"qty": p["qty"], "sales": p["amount"], "kontribusi_pct": round(p_kontribusi * 100, 6)},
            "growth_kontribusi_pct": round(growth * 100, 6),
        })
    rows.sort(key=lambda r: r["category"])

    return {
        "department": department.upper(),
        "as_of_date": str(as_of),
        "week_current": {"week_no": cur_week_idx + 1, "start": str(cur_start), "end": str(cur_end),
                          "total_qty": sum(v["qty"] for v in cur_data.values()), "total_sales": cur_total},
        "week_previous": {"week_no": cur_week_idx, "start": str(prev_start), "end": str(prev_end),
                           "total_qty": sum(v["qty"] for v in prev_data.values()), "total_sales": prev_total},
        "rows": rows,
    }


# --- Ditambahkan: WEEKLY MARGIN (Target vs Achievement), per outlet & departemen.
# URL: /api/method/custom_reports.sales_api.get_weekly_margin?department=FASHION&as_of_date=YYYY-MM-DD
#
# PENTING - minggu di laporan ini beda dgn "Weekly Sales Achievement": di sini
# minggu = Senin-Minggu (kalender), BUKAN blok 1-7/8-14/15-21/22-akhir. Divalidasi
# thd file "WEEKLY MARGIN AGUSTUS 2026" - sheet2 per minggu persis Senin-Minggu
# (mis. "24-30 Agustus" = Senin 24 s/d Minggu 30).
#
# Formula (divalidasi manual thd file perhitungan "WEEKLY MARGIN 24-30 AGT"):
#   SALES BRUTO       = SUM(grand_total) invoice non-retur (is_return=0)
#   - MEMBER-X, Potongan Penjualan, Promo-X, RAFAKSI DISCOUNT-X
#     (4 akun GL Entry terpisah, voucher_type='Sales Invoice', net debit-credit
#     per cost_center = outlet - BUKAN field loyalty_amount/discount_amount di
#     invoice, itu field lain yg tdk dipakai laporan ini)
#   = SALES BRUTO 2
#   - RETUR PENJUALAN  = SUM(ABS(grand_total)) invoice retur (is_return=1)
#   = SALES - RETUR  (ini "SALES" versi EXCLUDE PROMO di laporan)
#   + Promo-X (ditambah balik)
#   = SALES ACHV     (ini "SALES" versi INCLUDE PROMO di laporan)
#   HPP            = ABS(SUM(stock_value_difference)) utk voucher_type='Sales
#                    Invoice' di warehouse2 outlet itu (sama mekanisme dgn HPP
#                    "penjualan" di inventory_api.py)
#   deal margin clear = (SALES - RETUR) - HPP  ; % = deal margin clear / (SALES-RETUR)
#   deal margin +     = SALES ACHV - HPP       ; dipakai utk Achievement vs Target

_OUTLET_COST_CENTER = {
    "HCW": "HCW - X", "OCW": "OCW - X", "PSR": "PSR - X", "XCW": "XCW - X",
    "XJB": "XJB - X", "XPY": "XPY - X", "XSC": "XSC - X", "XSP": "XSP - X",
    "XSC-OL": "XSC-OL - X", "XSP-OL": "XSP-OL - X",
    "XSM": "XSM - X", "XMJ": "XMJ - X", "XWP": "XWP - X", "XPH": "XPH - X",
    "XTJ": "XTJ - X", "XCR": "XCR - X", "TASMU": "TASMU - X", "MNR": "MNR - X",
    "UIN": "UIN - X", "XSMGROW": "XSM GROW - X",
    "KMT": "KEMITRAAN - X", "MBG": "MBG - X", "XSL": "XSL - X",
}

_DEDUCTION_ACCOUNTS = ["MEMBER - X", "Potongan Penjualan", "Promo - X", "RAFAKSI DISCOUNT - X"]

# SALES BRUTO & RETUR PENJUALAN paling presisi diambil langsung dari akun GL
# income "Penjualan"/"Retur Penjualan" (bukan dihitung dari grand_total Sales
# Invoice, yg ternyata SUDAH netto dari ke-4 potongan) - divalidasi persis ke
# rupiah thd file referensi "WEEKLY MARGIN 24-30 AGT".
_GL_MARGIN_ACCOUNTS = ["Penjualan", "Retur Penjualan"] + _DEDUCTION_ACCOUNTS


def _monday_week_bounds(a_date):
    weekday = a_date.weekday()  # Senin=0
    monday = frappe.utils.add_days(a_date, -weekday)
    sunday = frappe.utils.add_days(monday, 6)
    return monday, sunday


def _gl_deductions_by_outlet(start_date, end_date, outlets):
    cost_centers = [_OUTLET_COST_CENTER[o] for o in outlets if o in _OUTLET_COST_CENTER]
    if not cost_centers:
        return {}
    cc_placeholders = ", ".join(["%s"] * len(cost_centers))
    acc_placeholders = ", ".join(["%s"] * len(_GL_MARGIN_ACCOUNTS))
    rows = frappe.db.sql(f"""
        SELECT cost_center, account, SUM(debit - credit) AS net
        FROM `tabGL Entry`
        WHERE voucher_type = 'Sales Invoice'
          AND posting_date BETWEEN %s AND %s
          AND cost_center IN ({cc_placeholders})
          AND account IN ({acc_placeholders})
        GROUP BY cost_center, account
    """, [start_date, end_date] + cost_centers + _GL_MARGIN_ACCOUNTS, as_dict=True)
    cc_to_outlet = {v: k for k, v in _OUTLET_COST_CENTER.items()}
    result = {}
    for r in rows:
        outlet = cc_to_outlet.get(r["cost_center"])
        if not outlet:
            continue
        result.setdefault(outlet, {})[r["account"]] = r["net"] or 0
    return result


def _hpp_by_outlet(start_date, end_date, outlets):
    # HPP dihitung dgn JOIN Stock Ledger Entry -> Sales Invoice lewat voucher_no,
    # lalu group by custom_outlet (BUKAN by warehouse). Warehouse fisik bisa
    # dipakai BERSAMA oleh >1 outlet (mis. "SELLING AREA XSM - X" dipakai baik
    # oleh Supermart maupun XSM Grow sekaligus - terbukti dari pengecekan
    # langsung: warehouse "XSM GROW - X" yg terpisah ternyata kosong/tdk dipakai
    # utk transaksi penjualan), jadi mapping per-warehouse tdk bisa diandalkan
    # utk memisahkan outlet. Join via custom_outlet jauh lebih akurat & sekalian
    # menghilangkan ambiguitas XSL vs SOCCERLITE.
    if not outlets:
        return {}
    placeholders = ", ".join(["%s"] * len(outlets))
    rows = frappe.db.sql(f"""
        SELECT si.custom_outlet AS outlet, SUM(sle.stock_value_difference) AS val
        FROM `tabStock Ledger Entry` sle
        INNER JOIN `tabSales Invoice` si ON si.name = sle.voucher_no
        WHERE sle.is_cancelled = 0
          AND sle.voucher_type = 'Sales Invoice'
          AND si.docstatus = 1
          AND si.posting_date BETWEEN %s AND %s
          AND si.custom_outlet IN ({placeholders})
        GROUP BY si.custom_outlet
    """, [start_date, end_date] + list(outlets), as_dict=True)
    return {r["outlet"]: abs(r["val"] or 0) for r in rows}


# Target margin % per outlet, Semester II 2026 - sumber: file "TARGET SALES
# UNIT BISNIS BARU", sheet "RESUME TARGET MARGIN". Nilai tetap (bukan per
# bulan) kecuali dinyatakan lain oleh tim. Disimpan sbg pecahan (0.255=25.5%).
_MARGIN_TARGET_PCT = {
    "XSC": 0.255, "PSR": 0.25, "XPY": 0.18, "XJB": 0.18, "XCW": 0.26, "XSP": 0.255,
    "HCW": 0.18, "XSC-OL": 0.22, "OCW": 0.22, "XSP-OL": 0.22,
    "XSM": 0.16, "XMJ": 0.16, "XWP": 0.16, "XPH": 0.16, "XTJ": 0.16, "XCR": 0.16,
    "TASMU": 0.16, "MNR": 0.16, "UIN": 0.25, "XSMGROW": 0.3,
    "MBG": 0.05, "KMT": 0.10, "XSL": 0.74,
}
_MARGIN_DEPT_TARGET_PCT = {"FASHION": 0.24, "FMCG": 0.16}


def _margin_row(outlet, label, gl, hpp, target_pct=None):
    # SALES BRUTO & RETUR diambil langsung dari akun GL income "Penjualan" /
    # "Retur Penjualan" (voucher_type Sales Invoice, cost_center=outlet) -
    # divalidasi cocok persis ke rupiah thd file referensi "24-30 AGT",
    # jauh lebih presisi drpd dihitung tdk langsung dari grand_total invoice.
    sales_bruto = -gl.get("Penjualan", 0)  # akun income: credit-normal -> net negatif saat ada penjualan
    retur = gl.get("Retur Penjualan", 0)
    member = gl.get("MEMBER - X", 0)
    potongan = gl.get("Potongan Penjualan", 0)
    promo = gl.get("Promo - X", 0)
    rafaksi = gl.get("RAFAKSI DISCOUNT - X", 0)
    sales_bruto_2 = sales_bruto - member - potongan - promo - rafaksi
    sales_retur = sales_bruto_2 - retur
    # SALES ACHV = SALES-RETUR + Promo + RAFAKSI (keduanya ditambah balik) -
    # ketahuan dari validasi Monthly Margin: FASHION sempat kelihatan cocok
    # cuma +Promo krn RAFAKSI FASHION kecil, tapi FMCG (RAFAKSI besar, mis.
    # Supermart Rp26jt) langsung ketahuan salah kalau RAFAKSI tdk diikutkan -
    # exact match ke Sheet4 "SALES ACHV" setelah RAFAKSI ditambahkan.
    sales_achv = sales_retur + promo + rafaksi
    deal_margin_clear = sales_retur - hpp
    deal_margin_plus = sales_achv - hpp
    # % margin (exclude promo) = deal margin clear / SALES-RETUR (exclude
    # promo) - ini formula File 1 "WEEKLY MARGIN AGUSTUS 2026" (laporan
    # resmi/output final), BUKAN dibagi SALES ACHV (incl promo) spt di file
    # kalkulasi "24-30 AGT" (beda ~0.8pp utk Cikiray: 19.79% vs 19.0%) - File 1
    # dikonfirmasi sbg acuan output resmi, jadi ikut formulanya.
    margin_pct = (deal_margin_clear / sales_retur * 100) if sales_retur else None
    # margin_pct_incl & achv_pct dipakai utk bandingkan ke target - divalidasi
    # persis thd referensi: ACHV = (deal_margin_plus/sales_achv) / target_pct
    margin_pct_incl = (deal_margin_plus / sales_achv * 100) if sales_achv else None
    achv_pct = (margin_pct_incl / (target_pct * 100) * 100) if (target_pct and margin_pct_incl is not None) else None
    return {
        "outlet": outlet, "label": label,
        "sales_bruto": sales_bruto, "member": member, "potongan_penjualan": potongan,
        "promo": promo, "rafaksi_discount": rafaksi, "sales_bruto_2": sales_bruto_2,
        "retur_penjualan": retur, "sales_retur": sales_retur, "sales_achv": sales_achv,
        "hpp": hpp, "deal_margin_clear": deal_margin_clear, "margin_pct": margin_pct,
        "deal_margin_plus": deal_margin_plus, "margin_pct_incl": margin_pct_incl,
