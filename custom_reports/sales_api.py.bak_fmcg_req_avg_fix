@frappe.whitelist()
def get_monthly_margin(department="FASHION", month=None, year=None):
    today = frappe.utils.getdate(frappe.utils.today())
    target_month = int(month) if month else today.month
    target_year = int(year) if year else today.year
    month_start, month_full_end = _month_range(target_year, target_month)
    is_current_month = (target_year, target_month) == (today.year, today.month)
    as_of = today if is_current_month else month_full_end

    dept = department.upper()

    if dept == "HO":
        kmt_mbg_sales = _sales_by_kmt_mbg(month_start, as_of)
        gl_data = _gl_deductions_by_outlet(month_start, as_of, ["XSL"])
        hpp_data = _hpp_by_outlet(month_start, as_of, ["XSL"])

        rows = [
            _margin_row_sales_only("KMT", "Kemitraan", kmt_mbg_sales.get("KMT", {}).get("sales", 0)),
            _margin_row("XSL", "Mini Soccer", gl_data.get("XSL", {}), hpp_data.get("XSL", 0),
                        target_pct=_MARGIN_TARGET_PCT.get("XSL")),
            _margin_row_sales_only("MBG", "MBG", kmt_mbg_sales.get("MBG", {}).get("sales", 0)),
        ]
        return {
            "department": dept, "bulan": _BULAN_ID[target_month - 1], "tahun": target_year,
            "period_start": str(month_start), "period_end": str(as_of), "rows": rows,
            "note": "Total Dept.Holding tdk dihitung krn margin KMT & MBG blm tersedia dari ERP",
        }

    outlets = _MARGIN_FASHION_OUTLETS if dept == "FASHION" else (
        _MARGIN_FMCG_OUTLETS if dept == "FMCG" else [dept] if dept in _OUTLET_COST_CENTER else []
    )

    gl_data = _gl_deductions_by_outlet(month_start, as_of, outlets)
    hpp_data = _hpp_by_outlet(month_start, as_of, outlets)

    rows = []
    for o in outlets:
        row = _margin_row(o, _OUTLET_LABELS.get(o, o), gl_data.get(o, {}), hpp_data.get(o, 0),
                           target_pct=_MARGIN_TARGET_PCT.get(o))
        rows.append(row)
        if o in _MARGIN_COMBINE_AFTER:
            label, members = _MARGIN_COMBINE_AFTER[o]
            rows.append(_combined_margin_row(label, members, gl_data, hpp_data))

    total_gl = {acc: sum(gl_data.get(o, {}).get(acc, 0) for o in outlets) for acc in _GL_MARGIN_ACCOUNTS}
    total_hpp = sum(hpp_data.get(o, 0) for o in outlets)
    total_row = _margin_row("TOTAL", "Total", total_gl, total_hpp,
                             target_pct=_MARGIN_DEPT_TARGET_PCT.get(dept))
    rows.append(total_row)

    return {
        "department": dept, "bulan": _BULAN_ID[target_month - 1], "tahun": target_year,
        "period_start": str(month_start), "period_end": str(as_of), "rows": rows,
    }


# --- Ditambahkan: MONTHLY Kontribusi Sales per Category - reuse PERSIS
# mekanisme get_kontribusi_sales_category (rollup ke parent item_group,
# TOPUP di-exclude), cuma rentang tanggalnya per BULAN vs bulan lalu, PLUS
# vs tahun lalu. EXCLUDE MBG/KMT/XSL (sesuai file referensi "KONTRIBUSI SALES
# CATEGORY AGUSTUS MoM YoY" - cuma sheet F&H.S & FMCG).
#
# CATATAN: kolom "VS LAST YEAR" TIDAK bisa dihitung scr presisi - data
# kategori (item_group) per Sales Invoice Item baru tersedia live sejak akhir
# April 2026 (sama spt limitasi historis lain di project ini), jadi utk bulan
# Agustus 2025 dkk TIDAK ADA sumber data kategori sama sekali. Field
# 'last_year' selalu None dgn catatan, BUKAN 0/dikira-kira.
@frappe.whitelist()
def get_monthly_kontribusi_sales_category(department="FASHION", month=None, year=None):
    today = frappe.utils.getdate(frappe.utils.today())
    target_month = int(month) if month else today.month
    target_year = int(year) if year else today.year
    month_start, month_full_end = _month_range(target_year, target_month)
    is_current_month = (target_year, target_month) == (today.year, today.month)
    as_of = today if is_current_month else month_full_end

    m1 = target_month - 1 if target_month > 1 else 12
    y1 = target_year if target_month > 1 else target_year - 1
    lm_start, _ = _month_range(y1, m1)
    lm_end = lm_start.replace(day=min(as_of.day, calendar.monthrange(y1, m1)[1]))

    outlets = _KATEGORI_DEPT_OUTLETS.get(department.upper(), [])
    cur_data = _category_sales(month_start, as_of, outlets)
    lm_data = _category_sales(lm_start, lm_end, outlets)

    cur_total = sum(v["amount"] for v in cur_data.values())
    lm_total = sum(v["amount"] for v in lm_data.values())

    rows = []
    for cat in sorted(set(cur_data) | set(lm_data)):
        c = cur_data.get(cat, {"qty": 0, "amount": 0})
        l = lm_data.get(cat, {"qty": 0, "amount": 0})
        c_pct = round(c["amount"] / cur_total * 100, 6) if cur_total else 0
        l_pct = round(l["amount"] / lm_total * 100, 6) if lm_total else 0
        rows.append({
            "category": cat,
            "month_current": {"qty": c["qty"], "sales": c["amount"], "kontribusi_pct": c_pct},
            "month_last_month": {"qty": l["qty"], "sales": l["amount"], "kontribusi_pct": l_pct},
            "growth_vs_last_month_pct": _pct_change(c_pct, l_pct),
            "month_last_year": None,
        })

    return {
        "department": department.upper(), "bulan": _BULAN_ID[target_month - 1], "tahun": target_year,
        "period_start": str(month_start), "period_end": str(as_of),
        "period_last_month_start": str(lm_start), "period_last_month_end": str(lm_end),
        "rows": rows,
        "note": "Perbandingan vs tahun lalu blm tersedia - data kategori (item_group) baru live sejak akhir April 2026, jadi tdk ada sumber data kategori utk periode tahun lalu.",
    }


# --- Pareto Sales per Item & per Kategori (80/20 analysis) + versi yg
# dibandingkan dgn Inventory saat ini. Dasar sort & klasifikasi ABC pakai
# nilai Rp (standar analisis ABC); qty tetap ditampilkan & dihitung cumulative
# %-nya sendiri, tapi di urutan yg sama (urutan Rp) spt tabel pareto pd
# umumnya - bukan di-sort ulang per metric.
#
# URL:
#   /api/method/custom_reports.sales_api.get_pareto_sales?department=FASHION&level=item&start_date=&end_date=
#   /api/method/custom_reports.sales_api.get_pareto_vs_inventory?department=FASHION&level=item&start_date=&end_date=

def _item_sales(start_date, end_date, outlets):
    if not outlets:
        return {}
    placeholders = ", ".join(["%s"] * len(outlets))
    rows = frappe.db.sql(f"""
        SELECT sii.item_code, MAX(sii.item_name) AS item_name,
               SUM(sii.qty) AS qty, SUM(sii.amount) AS amount
        FROM `tabSales Invoice Item` sii
        JOIN `tabSales Invoice` si ON si.name = sii.parent
        WHERE si.docstatus = 1 AND si.is_return = 0
          AND si.posting_date BETWEEN %s AND %s
          AND si.custom_outlet IN ({placeholders})
          AND sii.item_group != 'TOPUP'
        GROUP BY sii.item_code
    """, [start_date, end_date] + list(outlets), as_dict=True)
    return {r["item_code"]: {"label": r["item_name"] or r["item_code"], "qty": r["qty"] or 0, "amount": r["amount"] or 0} for r in rows}


def _pareto_dept_outlets(department):
    dept = (department or "FASHION").upper()
    if dept == "ALL":
        outlets = _FASHION_OUTLETS + [o for o in _FMCG_OUTLETS if o != "KMT"] + [_MINI_SOCCER_OUTLET]
    else:
        outlets = _KATEGORI_DEPT_OUTLETS.get(dept, [])
    return dept, outlets


def _pareto_default_dates(start_date, end_date):
    today = frappe.utils.getdate(frappe.utils.today())
    end = frappe.utils.getdate(end_date) if end_date else today
    start = frappe.utils.getdate(start_date) if start_date else end.replace(day=1)
    return start, end


def _pareto_rows(start_date, end_date, outlets, level):
    data = _item_sales(start_date, end_date, outlets) if level == "item" else _category_sales(start_date, end_date, outlets)
    items = []
    for key, d in data.items():
        label = d["label"] if level == "item" else key
        items.append({"key": key, "label": label, "qty": d.get("qty", 0), "sales_rp": d.get("amount", 0)})
    items.sort(key=lambda r: r["sales_rp"], reverse=True)

    total_qty = sum(r["qty"] for r in items) or 0
    total_sales = sum(r["sales_rp"] for r in items) or 0

    cum_qty, cum_sales = 0, 0
    for i, r in enumerate(items):
        cum_qty += r["qty"]
        cum_sales += r["sales_rp"]
        sales_cum_pct = round(cum_sales / total_sales * 100, 2) if total_sales else 0
        r.update({
            "rank": i + 1,
            "qty_pct": round(r["qty"] / total_qty * 100, 2) if total_qty else 0,
            "sales_pct": round(r["sales_rp"] / total_sales * 100, 2) if total_sales else 0,
            "qty_cum_pct": round(cum_qty / total_qty * 100, 2) if total_qty else 0,
            "sales_cum_pct": sales_cum_pct,
            "pareto_class": "A" if sales_cum_pct <= 80 else ("B" if sales_cum_pct <= 95 else "C"),
        })
    return items, total_qty, total_sales


@frappe.whitelist()
def get_pareto_sales(department="FASHION", level="item", start_date=None, end_date=None):
    level = "category" if (level or "item").lower().startswith("cat") else "item"
    dept, outlets = _pareto_dept_outlets(department)
    start, end = _pareto_default_dates(start_date, end_date)

    rows, total_qty, total_sales = _pareto_rows(start, end, outlets, level)
    key_label = "item_code" if level == "item" else "category"
    for r in rows:
        r[key_label] = r.pop("key")
        if level == "item":
            r["item_name"] = r.pop("label")
        else:
            r.pop("label", None)

    return {
        "department": dept, "level": level,
        "start_date": str(start), "end_date": str(end),
        "total_qty": total_qty, "total_sales_rp": total_sales,
        "rows": rows,
        "note": "Kategori TOPUP di-exclude. pareto_class (A/B/C) dihitung dari cumulative % nilai Rp (A s.d. 80%, B s.d. 95%, C sisanya); urutan baris & cumulative % qty mengikuti urutan Rp yg sama, bukan di-sort ulang per metric.",
    }


def _current_stock_by(level, warehouses, exclude_item_groups=None):
    if not warehouses:
        return {}
    wh_placeholders = ", ".join(["%s"] * len(warehouses))
    params = list(warehouses)
    item_cond = ""
    if exclude_item_groups:
        ig_placeholders = ", ".join(["%s"] * len(exclude_item_groups))
        item_cond = f"AND i.item_group NOT IN ({ig_placeholders})"
        params += list(exclude_item_groups)

    if level == "item":
        rows = frappe.db.sql(f"""
            SELECT b.item_code AS k, SUM(b.actual_qty) AS qty, SUM(b.stock_value) AS value
            FROM `tabBin` b
            JOIN `tabItem` i ON i.name = b.item_code
            WHERE b.warehouse IN ({wh_placeholders})
            {item_cond}
            GROUP BY b.item_code
        """, params, as_dict=True)
    else:
        rows = frappe.db.sql(f"""
            SELECT COALESCE(ig.parent_item_group, i.item_group, '(Tanpa Kategori)') AS k,
                   SUM(b.actual_qty) AS qty, SUM(b.stock_value) AS value
            FROM `tabBin` b
            JOIN `tabItem` i ON i.name = b.item_code
            LEFT JOIN `tabItem Group` ig ON ig.name = i.item_group
            WHERE b.warehouse IN ({wh_placeholders})
            {item_cond}
            GROUP BY COALESCE(ig.parent_item_group, i.item_group, '(Tanpa Kategori)')
        """, params, as_dict=True)
    return {r["k"]: {"qty": r["qty"] or 0, "value": r["value"] or 0} for r in rows}


@frappe.whitelist()
def get_pareto_vs_inventory(department="FASHION", level="item", start_date=None, end_date=None):
    from custom_reports.inventory_api import _OUTLET_WAREHOUSES, _FASHION_ROWS, _FMCG_ROWS

    level = "category" if (level or "item").lower().startswith("cat") else "item"
    dept, outlets = _pareto_dept_outlets(department)
    start, end = _pareto_default_dates(start_date, end_date)

    dept_u = dept.upper()
    if dept_u == "FASHION":
        wh_outlet_codes = _FASHION_ROWS
    elif dept_u == "FMCG":
        wh_outlet_codes = _FMCG_ROWS
    elif dept_u == "ALL":
        wh_outlet_codes = _FASHION_ROWS + _FMCG_ROWS
    else:
        wh_outlet_codes = []
    warehouses = [wh for code in wh_outlet_codes for wh in _OUTLET_WAREHOUSES.get(code, [])]

    rows, total_qty, total_sales = _pareto_rows(start, end, outlets, level)
    stock = _current_stock_by(level, warehouses, exclude_item_groups=["TOPUP"])

    stock_as_of = str(frappe.utils.getdate(frappe.utils.today()))
    key_label = "item_code" if level == "item" else "category"
    for r in rows:
        key = r.pop("key")
        r[key_label] = key
        if level == "item":
            r["item_name"] = r.pop("label")
        else:
            r.pop("label", None)
        s = stock.get(key, {"qty": 0, "value": 0})
        r["stock_qty"] = s["qty"]
        r["stock_value_rp"] = s["value"]

    return {
        "department": dept, "level": level,
        "start_date": str(start), "end_date": str(end),
        "stock_as_of": stock_as_of,
        "total_qty": total_qty, "total_sales_rp": total_sales,
        "rows": rows,
        "note": (
            "stock_qty/stock_value_rp adalah posisi stok SAAT INI (real-time dari Bin, bukan historis per "
            "tanggal end_date) - dibandingkan dengan sales pada rentang start_date s.d. end_date. Kategori TOPUP "
            "di-exclude dari kedua sisi. XSMGROW blm py pemetaan warehouse di sistem ini, jadi stock_qty/value "
            "utk item yg cuma dijual di XSMGROW kemungkinan 0/kurang lengkap."
        ),
    }


# --- SEMENTARA utk debug/validasi: Service Level per Category, TANPA filter
# department dulu (blm tau mekanisme scoping FASHION vs FMCG utk data
# Purchase Order/Receipt). Formula: SERVEL = Nilai RCV / Nilai PO, dimana
# Nilai = SUM(qty * Item.last_purchase_rate), di-rollup ke parent item_group
# (sama pola dgn Kontribusi Sales Category).
@frappe.whitelist()
def debug_servel_raw(month=None, year=None):
    """Debug tanpa JOIN Item Group sama sekali - cek apakah nilai mentahnya
    sudah wajar sebelum ditambah rollup kategori (isolasi sumber bug fan-out)."""
    today = frappe.utils.getdate(frappe.utils.today())
    target_month = int(month) if month else today.month
    target_year = int(year) if year else today.year
    month_start, month_full_end = _month_range(target_year, target_month)
    as_of = today if (target_year, target_month) == (today.year, today.month) else month_full_end

    po_total = frappe.db.sql("""
        SELECT SUM(poi.qty * it.last_purchase_rate) AS nilai, COUNT(*) AS n
        FROM `tabPurchase Order Item` poi
        JOIN `tabPurchase Order` po ON po.name = poi.parent
        JOIN `tabItem` it ON it.name = poi.item_code
        WHERE po.docstatus = 1 AND po.transaction_date BETWEEN %s AND %s
    """, (month_start, as_of), as_dict=True)[0]

    rcv_total = frappe.db.sql("""
        SELECT SUM(pri.qty * it.last_purchase_rate) AS nilai, COUNT(*) AS n
        FROM `tabPurchase Receipt Item` pri
        JOIN `tabPurchase Receipt` pr ON pr.name = pri.parent
        JOIN `tabItem` it ON it.name = pri.item_code
        WHERE pr.docstatus = 1 AND pr.posting_date BETWEEN %s AND %s
    """, (month_start, as_of), as_dict=True)[0]

    # cek jg count item group duplikat by name case-insensitive (kemungkinan
    # penyebab fan-out JOIN)
    dup_check = frappe.db.sql("""
        SELECT LOWER(name) AS lname, COUNT(*) AS n
        FROM `tabItem Group`
        GROUP BY LOWER(name)
        HAVING COUNT(*) > 1
    """, as_dict=True)

    return {
        "po_total": po_total, "rcv_total": rcv_total,
        "item_group_name_dup_case_insensitive": dup_check,
    }


@frappe.whitelist()
def debug_service_level_category(month=None, year=None):
    today = frappe.utils.getdate(frappe.utils.today())
    target_month = int(month) if month else today.month
    target_year = int(year) if year else today.year
    month_start, month_full_end = _month_range(target_year, target_month)
    is_current_month = (target_year, target_month) == (today.year, today.month)
    as_of = today if is_current_month else month_full_end

    po_rows = frappe.db.sql("""
        SELECT COALESCE(ig.parent_item_group, it.item_group, '(Tanpa Kategori)') AS category,
               SUM(poi.qty * it.last_purchase_rate) AS nilai
        FROM `tabPurchase Order Item` poi
        JOIN `tabPurchase Order` po ON po.name = poi.parent
        JOIN `tabItem` it ON it.name = poi.item_code
        LEFT JOIN `tabItem Group` ig ON ig.name = it.item_group
        WHERE po.docstatus = 1
          AND po.transaction_date BETWEEN %s AND %s
        GROUP BY category
    """, (month_start, as_of), as_dict=True)

    rcv_rows = frappe.db.sql("""
        SELECT COALESCE(ig.parent_item_group, it.item_group, '(Tanpa Kategori)') AS category,
               SUM(pri.qty * it.last_purchase_rate) AS nilai
        FROM `tabPurchase Receipt Item` pri
        JOIN `tabPurchase Receipt` pr ON pr.name = pri.parent
        JOIN `tabItem` it ON it.name = pri.item_code
        LEFT JOIN `tabItem Group` ig ON ig.name = it.item_group
        WHERE pr.docstatus = 1
          AND pr.posting_date BETWEEN %s AND %s
        GROUP BY category
    """, (month_start, as_of), as_dict=True)

    po_map = {r["category"]: r["nilai"] or 0 for r in po_rows}
    rcv_map = {r["category"]: r["nilai"] or 0 for r in rcv_rows}

    rows = []
    for cat in sorted(set(po_map) | set(rcv_map)):
        po_val = po_map.get(cat, 0)
        rcv_val = rcv_map.get(cat, 0)
        rows.append({
            "category": cat, "nilai_po": po_val, "nilai_rcv": rcv_val,
            "servel": round(rcv_val / po_val, 6) if po_val else None,
        })

    total_po = sum(po_map.values())
    total_rcv = sum(rcv_map.values())
    return {
        "period_start": str(month_start), "period_end": str(as_of),
        "grand_total": {"nilai_po": total_po, "nilai_rcv": total_rcv,
                         "servel": round(total_rcv / total_po, 6) if total_po else None},
        "rows": rows,
    }
