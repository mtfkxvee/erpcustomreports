import frappe

@frappe.whitelist()
def get_sales_today(date=None):
    today = date or frappe.utils.today()
    data = frappe.db.sql("""
        SELECT
            s.outlet,
            o.nama AS outlet_nama,
            o.parent_outlet AS dept,
            s.total_sales,
            s.total_trx,
            MAX(std.target_harian) AS target_harian,
            ROUND(s.total_sales / NULLIF(MAX(std.target_harian), 0) * 100, 2) AS achievement_pct
        FROM (
            SELECT
                custom_outlet AS outlet,
                SUM(grand_total) AS total_sales,
                COUNT(name) AS total_trx
            FROM `tabSales Invoice`
            WHERE docstatus = 1
                AND is_return = 0
                AND posting_date = %s
                AND NOT (
                    loyalty_amount > 0
                    AND loyalty_amount >= grand_total
                    AND name NOT IN (SELECT DISTINCT parent FROM `tabSales Invoice Payment`)
                )
            GROUP BY custom_outlet
        ) s
        LEFT JOIN `tabOutlet` o ON o.name = s.outlet
        LEFT JOIN `tabSales Target Daily` std
            ON std.parent = s.outlet
            AND std.tanggal = %s
        GROUP BY s.outlet, s.total_sales, s.total_trx, o.nama, o.parent_outlet
        ORDER BY s.total_sales DESC
    """, (today, today), as_dict=True)
    return data


# --- Ditambahkan: laporan Sales vs Target per departemen (Fashion/FMCG/Mini Soccer) ---
# URL: /api/method/custom_reports.sales_api.get_sales_vs_target?as_of_date=YYYY-MM-DD

import calendar

_FASHION_OUTLETS = ["HCW", "OCW", "PSR", "XCW", "XJB", "XPY", "XSC", "XSP", "XSC-OL", "XSP-OL"]
_FMCG_OUTLETS = ["MNR", "TASMU", "UIN", "XCR", "XMJ", "XPH", "XSM", "XSMGROW", "XTJ", "XWP", "KMT"]
_MBG_OUTLET = "MBG"
_MINI_SOCCER_OUTLET = "XSL"

_BULAN_ID = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli",
             "Agustus", "September", "Oktober", "November", "Desember"]

# Disamakan persis dgn report resmi "Laporan Penjualan Harian" (sales_api lama
# cuma exclude invoice yg 100% bayar loyalty; yg bener: loyalty_amount SELALU
# dikurangi dari grand_total di SETIAP invoice, sebagian ataupun penuh - dan
# TIDAK ada filter is_pos di report resmi itu, jadi dihapus juga di sini).
_SALES_WHERE = """
    docstatus = 1
    AND is_return = 0
    AND posting_date BETWEEN %s AND %s
"""


def _sales_by_outlet(start_date, end_date):
    rows = frappe.db.sql(f"""
        SELECT custom_outlet AS outlet,
               SUM(grand_total - COALESCE(loyalty_amount, 0)) AS sales,
               COUNT(name) AS trx
        FROM `tabSales Invoice`
        WHERE {_SALES_WHERE}
        GROUP BY custom_outlet
    """, (start_date, end_date), as_dict=True)
    return {r["outlet"]: {"sales": r["sales"] or 0, "trx": r["trx"] or 0} for r in rows}


def _target_by_outlet(bulan_label):
    # COALESCE(so.outlet, stm.parent): sebagian record "Sales Target Outlet" nama
    # dokumennya TIDAK sama dgn kode outlet (mis. auto-generated hash spt
    # "i9nrri1c58" utk outlet "XSC-OL", atau beda case spt "xsc" utk "XSC") -
    # jadi ambil dari field link `outlet` dulu kalau ada, baru fallback ke nama
    # dokumen. .upper() jaga2 dari sisa masalah case.
    rows = frappe.db.sql("""
        SELECT COALESCE(so.outlet, stm.parent) AS outlet, stm.target_bulan AS target
        FROM `tabSales Target Monthly` stm
        JOIN `tabSales Target Outlet` so ON so.name = stm.parent
        WHERE stm.bulan = %s
    """, (bulan_label,), as_dict=True)
    return {r["outlet"].upper(): r["target"] or 0 for r in rows}


def _sales_by_outlet_history(start_date, end_date):
    """Sama spt _sales_by_outlet, tapi sumbernya doctype 'Outlet Daily Sales History'
    (data histori 2025 & awal 2026 yg diinput manual dari Excel, krn Sales Invoice
    di ERP ini baru mulai ada data live sejak akhir April 2026)."""
    rows = frappe.db.sql("""
        SELECT outlet, SUM(nominal) AS sales, SUM(jumlah_transaksi) AS trx
        FROM `tabOutlet Daily Sales History`
        WHERE tanggal BETWEEN %s AND %s
        GROUP BY outlet
    """, (start_date, end_date), as_dict=True)
    return {r["outlet"]: {"sales": r["sales"] or 0, "trx": r["trx"] or 0} for r in rows}


def _sales_by_kmt_mbg(start_date, end_date):
    """KMT (Kemitraan) & MBG dari doctype 'Kemitraan MBG Sales History' (input
    manual dari Excel) — outlet KMT & MBG terbukti 0 transaksi di Sales Invoice
    ERP ini (lihat audit), jadi datanya diambil dari sini, bukan dari Sales Invoice."""
    rows = frappe.db.sql("""
        SELECT kategori, SUM(nominal) AS sales, SUM(jumlah_transaksi) AS trx
        FROM `tabKemitraan MBG Sales History`
        WHERE tanggal BETWEEN %s AND %s
        GROUP BY kategori
    """, (start_date, end_date), as_dict=True)
    mapping = {"Kemitraan": "KMT", "MBG": "MBG"}
    return {mapping[r["kategori"]]: {"sales": r["sales"] or 0, "trx": r["trx"] or 0} for r in rows if r["kategori"] in mapping}


def _kmt_only(start_date, end_date):
    """KMT (Kemitraan) SAJA, tanpa MBG — dipakai utk kolom histori (MTD Bulan
    Lalu/MTD Tahun Lalu/Monthly Tahun Lalu) krn laporan asli terbukti include
    Kemitraan tapi TIDAK include MBG di kolom2 itu (divalidasi manual thd data
    per-outlet: MTD Sept 2025 & Monthly Sept 2025 cocok nyaris exact dgn rumus
    ini, beda <0.2%)."""
    rows = frappe.db.sql("""
        SELECT SUM(nominal) AS sales, SUM(jumlah_transaksi) AS trx
        FROM `tabKemitraan MBG Sales History`
        WHERE tanggal BETWEEN %s AND %s AND kategori = 'Kemitraan'
    """, (start_date, end_date), as_dict=True)
    r = rows[0] if rows else {}
    return {"KMT": {"sales": r.get("sales") or 0, "trx": r.get("trx") or 0}}


@frappe.whitelist()
def get_sales_vs_target(as_of_date=None):
    as_of = frappe.utils.getdate(as_of_date or frappe.utils.today())
    month_start = as_of.replace(day=1)
    bulan_ini = _BULAN_ID[as_of.month - 1]
    days_in_month = calendar.monthrange(as_of.year, as_of.month)[1]
    standard_achieve_pct = round(as_of.day / days_in_month * 100, 2)

    last_month_end = frappe.utils.add_days(month_start, -1)
    last_month_start = last_month_end.replace(day=1)
    last_month_same_day = min(as_of.day, calendar.monthrange(last_month_end.year, last_month_end.month)[1])
    last_month_mtd_end = last_month_start.replace(day=last_month_same_day)

    last_year = as_of.year - 1
    last_year_days = calendar.monthrange(last_year, as_of.month)[1]
    last_year_month_start = frappe.utils.getdate(f"{last_year}-{as_of.month:02d}-01")
    last_year_mtd_end = frappe.utils.getdate(f"{last_year}-{as_of.month:02d}-{min(as_of.day, last_year_days):02d}")
    last_year_month_end = frappe.utils.getdate(f"{last_year}-{as_of.month:02d}-{last_year_days:02d}")

    daily = _sales_by_outlet(as_of, as_of)
    accumulated = _sales_by_outlet(month_start, as_of)
    mtd_last_month = _sales_by_outlet(last_month_start, last_month_mtd_end)
    mtd_last_month.pop("XSMGROW", None)  # outlet baru (buka 8 Agustus 2026), blm py
    # basis pembanding "bulan lalu" yg wajar - laporan asli sengaja exclude dia
    # dari kolom ini (divalidasi: gap Total FMCG MTD Agustus persis sama dgn
    # kontribusi XSM Grow sebelum di-exclude).
    mtd_last_year = _sales_by_outlet_history(last_year_month_start, last_year_mtd_end)
    monthly_last_year = _sales_by_outlet_history(last_year_month_start, last_year_month_end)

    # KMT & MBG: periode "sekarang-ish" (Daily, Accumulated, MTD Bulan Lalu)
    # include KEDUANYA. Periode "Tahun Lalu" (MTD & Monthly Tahun Lalu) cuma
    # include KMT (Kemitraan), TANPA MBG — divalidasi manual thd laporan asli:
    # MBG blm py pembanding tahun lalu yg diakui (lihat docstring _kmt_only()).
    daily.update(_sales_by_kmt_mbg(as_of, as_of))
    accumulated.update(_sales_by_kmt_mbg(month_start, as_of))
    mtd_last_month.update(_sales_by_kmt_mbg(last_month_start, last_month_mtd_end))
    mtd_last_year.update(_kmt_only(last_year_month_start, last_year_mtd_end))
    monthly_last_year.update(_kmt_only(last_year_month_start, last_year_month_end))

    targets = _target_by_outlet(bulan_ini)

    def agg(outlets, src):
        return {
            "trx": sum(src.get(o, {}).get("trx", 0) for o in outlets),
            "sales": sum(src.get(o, {}).get("sales", 0) for o in outlets),
        }

    def target_sum(outlets):
        return sum(targets.get(o, 0) for o in outlets)

    def pct_change(new, old):
        if not old:
            return None
        return round((new / old - 1) * 100, 2)

    def build_row(label, outlets, target_outlets=None):
        target_outlets = target_outlets or outlets
        d, a, lm = agg(outlets, daily), agg(outlets, accumulated), agg(outlets, mtd_last_month)
        ly, myly = agg(outlets, mtd_last_year), agg(outlets, monthly_last_year)
        tgt = target_sum(target_outlets)
        achv = round(a["sales"] / tgt * 100, 2) if tgt else None
        return {
            "department": label,
            "target": tgt,
            "daily_tc": d["trx"], "daily_sales": d["sales"],
            "acc_tc": a["trx"], "acc_sales": a["sales"],
            "achv_vs_target_pct": achv,
            "vs_standard_achv_pct": round(achv - standard_achieve_pct, 2) if achv is not None else None,
            "mtd_last_month_tc": lm["trx"], "mtd_last_month_sales": lm["sales"],
            "vs_last_month_tc_pct": pct_change(a["trx"], lm["trx"]),
            "vs_last_month_sales_pct": pct_change(a["sales"], lm["sales"]),
            "mtd_last_year_tc": ly["trx"], "mtd_last_year_sales": ly["sales"],
            "vs_last_year_tc_pct": pct_change(a["trx"], ly["trx"]),
            "vs_last_year_sales_pct": pct_change(a["sales"], ly["sales"]),
            "monthly_sales_last_year": myly["sales"],
            "pct_2026_vs_2025": pct_change(a["sales"], myly["sales"]),
        }

    rows = [
        # Catatan: target_outlets TIDAK di-override lagi utk baris "exclude" -
        # biar target-nya ikut kurang sesuai outlet yg di-exclude dari sales-nya
        # juga (sebelumnya target selalu pakai total dept penuh, salah, gak
        # sesuai foto laporan asli).
        build_row("F&H.S exclude HCW", [o for o in _FASHION_OUTLETS if o != "HCW"]),
        build_row("Total Fashion & Home Supplies", _FASHION_OUTLETS),
        build_row("Fmcg exclude MBG", _FMCG_OUTLETS),
        build_row("Fmcg exclude UIN", [o for o in _FMCG_OUTLETS if o != "UIN"] + [_MBG_OUTLET]),
        build_row("Total FMCG", _FMCG_OUTLETS + [_MBG_OUTLET]),
        build_row("Mini Soccer", [_MINI_SOCCER_OUTLET]),
    ]
    grand_outlets = _FASHION_OUTLETS + _FMCG_OUTLETS + [_MBG_OUTLET, _MINI_SOCCER_OUTLET]
    rows.append(build_row("TOTAL Exclude MBG", [o for o in grand_outlets if o != _MBG_OUTLET]))
    rows.append(build_row("TOTAL Exclude UIN & HCW", [o for o in grand_outlets if o not in ("UIN", "HCW")]))
    rows.append(build_row("GRAND TOTAL", grand_outlets))

    return {"as_of_date": str(as_of), "bulan": bulan_ini, "rows": rows}


# --- Ditambahkan: detail Sales vs Target PER OUTLET, per departemen ---
# URL: /api/method/custom_reports.sales_api.get_sales_vs_target_detail?department=FASHION&as_of_date=YYYY-MM-DD
# department: "FASHION" atau "FMCG"

_FASHION_OFFLINE = ["HCW", "PSR", "XPY", "XJB", "XCW", "XSP", "XSC"]
_FASHION_ONLINE = ["OCW", "XSC-OL", "XSP-OL"]
_FMCG_ALL = ["XSM", "XMJ", "XWP", "XPH", "XTJ", "XCR", "TASMU", "MNR", "UIN", "XSMGROW", "KMT", "MBG"]

_OUTLET_LABELS = {
    "HCW": "X-sha rumah kedua", "PSR": "Pasar", "XPY": "Panyingkiran", "XJB": "Furniture",
    "XCW": "Ciawi", "XSP": "Sp Fashion", "XSC": "Cikiray",
    "OCW": "Online Ciawi", "XSC-OL": "Online Cikiray", "XSP-OL": "Online Sp Fashion",
    "XSM": "Supermart", "XMJ": "X-Shamart Mangunreja", "XWP": "X-Shamart Wr Peuteuy",
    "XPH": "X-Shamart Puspahiang", "XTJ": "X-Shamart Tanjung jaya", "XCR": "X-Shamart Cisaruni",
    "TASMU": "Tasmu Mart", "MNR": "Menara X-Shamart", "UIN": "UIN Grow", "XSMGROW": "XSM Grow",
    "KMT": "Kemitraan", "MBG": "MBG",
}


def _pct_change(new, old):
    if not old:
        return None
    return round((new / old - 1) * 100, 2)


@frappe.whitelist()
def get_sales_vs_target_detail(department="FASHION", month=None, year=None, as_of_date=None):
    # Cukup kirim month/year: kalau bulan yg diminta = bulan BERJALAN, otomatis
    # dihitung MTD s.d. hari ini; kalau bulan yg sudah LEWAT, otomatis dihitung
    # penuh 1 s.d. akhir bulan itu. Param as_of_date tetap ada (opsional) utk
    # override manual/testing - kalau diisi, prioritas dari month/year.
    today = frappe.utils.getdate(frappe.utils.today())
    if as_of_date:
        as_of = frappe.utils.getdate(as_of_date)
    else:
        target_month = int(month) if month else today.month
        target_year = int(year) if year else today.year
        if (target_year, target_month) == (today.year, today.month):
            as_of = today
        else:
            last_day = calendar.monthrange(target_year, target_month)[1]
            as_of = frappe.utils.getdate(f"{target_year}-{target_month:02d}-{last_day:02d}")
    month_start = as_of.replace(day=1)
    bulan_ini = _BULAN_ID[as_of.month - 1]
    days_in_month = calendar.monthrange(as_of.year, as_of.month)[1]
    standard_achieve_pct = round(as_of.day / days_in_month * 100, 2)

    last_month_end = frappe.utils.add_days(month_start, -1)
    last_month_start = last_month_end.replace(day=1)
    last_month_same_day = min(as_of.day, calendar.monthrange(last_month_end.year, last_month_end.month)[1])
    last_month_mtd_end = last_month_start.replace(day=last_month_same_day)

    last_year = as_of.year - 1
    last_year_mtd_start = frappe.utils.getdate(f"{last_year}-{as_of.month:02d}-01")
    last_year_days = calendar.monthrange(last_year, as_of.month)[1]
    last_year_mtd_end = frappe.utils.getdate(f"{last_year}-{as_of.month:02d}-{min(as_of.day, last_year_days):02d}")
    last_year_month_end = frappe.utils.getdate(f"{last_year}-{as_of.month:02d}-{last_year_days:02d}")

    daily = _sales_by_outlet(as_of, as_of)
    accumulated = _sales_by_outlet(month_start, as_of)
    mtd_last_month = _sales_by_outlet(last_month_start, last_month_mtd_end)
    mtd_last_month.pop("XSMGROW", None)  # outlet baru (buka 8 Agustus 2026) - lihat
    # catatan sama di get_sales_vs_target.
    mtd_last_year = _sales_by_outlet_history(last_year_mtd_start, last_year_mtd_end)
    monthly_last_year = _sales_by_outlet_history(last_year_mtd_start.replace(day=1), last_year_month_end)

    # KMT & MBG: periode "sekarang-ish" include KEDUANYA; "tahun lalu" cuma KMT
    # (sama spt get_sales_vs_target - lihat docstring _kmt_only()).
    daily.update(_sales_by_kmt_mbg(as_of, as_of))
    accumulated.update(_sales_by_kmt_mbg(month_start, as_of))
    mtd_last_month.update(_sales_by_kmt_mbg(last_month_start, last_month_mtd_end))
    mtd_last_year.update(_kmt_only(last_year_mtd_start, last_year_mtd_end))
    monthly_last_year.update(_kmt_only(last_year_mtd_start.replace(day=1), last_year_month_end))

    targets = _target_by_outlet(bulan_ini)

    def get(src, outlet):
        v = src.get(outlet, {})
        return v.get("trx", 0), v.get("sales", 0)

    remaining_days = days_in_month - as_of.day

    def _projection(target, acc_sales):
        # Proyeksi Balance To Achv 90%/100% & rata-rata harian yg perlu
        # dicapai sisa hari bulan ini - sesuai kolom di file "SALES REPORT HO"
        # sheet ALL/DEPT. Kalau tanggal sudah di akhir bulan (remaining_days=0),
        # rata-rata harian yg perlu None (bukan divide-by-zero '#DIV/0!' spt Excel).
        target_90 = target * 0.9
        balance_90 = target_90 - acc_sales
        avg_90 = round(balance_90 / remaining_days, 2) if remaining_days else None
        balance_100 = target - acc_sales
        avg_100 = round(balance_100 / remaining_days, 2) if remaining_days else None
        return {
            "target_90pct": round(target_90, 2), "balance_to_90pct": round(balance_90, 2),
            "avg_daily_needed_90pct": avg_90,
            "target_100pct": round(target, 2), "balance_to_100pct": round(balance_100, 2),
            "avg_daily_needed_100pct": avg_100,
        }

    def outlet_row(outlet):
        d_tc, d_sales = get(daily, outlet)
        a_tc, a_sales = get(accumulated, outlet)
        lm_tc, lm_sales = get(mtd_last_month, outlet)
        ly_tc, ly_sales = get(mtd_last_year, outlet)
        _, myly_sales = get(monthly_last_year, outlet)
        target = targets.get(outlet, 0)
        achv = round(a_sales / target * 100, 2) if target else None
        row = {
            "outlet": outlet, "outlet_label": _OUTLET_LABELS.get(outlet, outlet),
            "target": target,
            "daily_tc": d_tc, "daily_sales": d_sales,
            "acc_tc": a_tc, "acc_sales": a_sales,
            "achv_vs_target_pct": achv,
            "vs_standard_achv_pct": round(achv - standard_achieve_pct, 2) if achv is not None else None,
            "mtd_last_month_tc": lm_tc, "mtd_last_month_sales": lm_sales,
            "vs_last_month_tc_pct": _pct_change(a_tc, lm_tc),
            "vs_last_month_sales_pct": _pct_change(a_sales, lm_sales),
            "mtd_last_year_tc": ly_tc, "mtd_last_year_sales": ly_sales,
            "vs_last_year_tc_pct": _pct_change(a_tc, ly_tc),
            "vs_last_year_sales_pct": _pct_change(a_sales, ly_sales),
            "monthly_sales_last_year": myly_sales,
            "pct_2026_vs_2025": _pct_change(a_sales, myly_sales),
        }
        row.update(_projection(target, a_sales))
        return row

    def subtotal_row(label, outlets, target_outlets=None):
        target_outlets = target_outlets or outlets
        d_tc = sum(get(daily, o)[0] for o in outlets); d_sales = sum(get(daily, o)[1] for o in outlets)
        a_tc = sum(get(accumulated, o)[0] for o in outlets); a_sales = sum(get(accumulated, o)[1] for o in outlets)
        lm_tc = sum(get(mtd_last_month, o)[0] for o in outlets); lm_sales = sum(get(mtd_last_month, o)[1] for o in outlets)
        ly_tc = sum(get(mtd_last_year, o)[0] for o in outlets); ly_sales = sum(get(mtd_last_year, o)[1] for o in outlets)
        myly_sales = sum(get(monthly_last_year, o)[1] for o in outlets)
        target = sum(targets.get(o, 0) for o in target_outlets)
        achv = round(a_sales / target * 100, 2) if target else None
        row = {
            "outlet": label, "outlet_label": label,
            "target": target,
            "daily_tc": d_tc, "daily_sales": d_sales,
            "acc_tc": a_tc, "acc_sales": a_sales,
            "achv_vs_target_pct": achv,
            "vs_standard_achv_pct": round(achv - standard_achieve_pct, 2) if achv is not None else None,
            "mtd_last_month_tc": lm_tc, "mtd_last_month_sales": lm_sales,
            "vs_last_month_tc_pct": _pct_change(a_tc, lm_tc),
            "vs_last_month_sales_pct": _pct_change(a_sales, lm_sales),
            "mtd_last_year_tc": ly_tc, "mtd_last_year_sales": ly_sales,
            "vs_last_year_tc_pct": _pct_change(a_tc, ly_tc),
            "vs_last_year_sales_pct": _pct_change(a_sales, ly_sales),
            "monthly_sales_last_year": myly_sales,
            "pct_2026_vs_2025": _pct_change(a_sales, myly_sales),
        }
        row.update(_projection(target, a_sales))
        return row

    dept = department.upper()
    if dept == "FASHION":
        all_outlets = _FASHION_OFFLINE + _FASHION_ONLINE
        rows = [outlet_row(o) for o in _FASHION_OFFLINE]
        rows.append(subtotal_row("Total Outlet - Offline", _FASHION_OFFLINE))
        rows.append(subtotal_row("Total Outlet - Online", _FASHION_ONLINE))
        rows.append(subtotal_row("TOTAL DEPT F&H.S EXC HCW", [o for o in all_outlets if o != "HCW"]))
        rows.append(subtotal_row("TOTAL DEPT F&H.S ALL", all_outlets))
    elif dept == "FMCG":
        rows = [outlet_row(o) for o in _FMCG_ALL]
        rows.append(subtotal_row("FMCG Exclude MBG", [o for o in _FMCG_ALL if o != "MBG"]))
        rows.append(subtotal_row("TOTAL DEPT.FMCG ALL", _FMCG_ALL))
        rows.append(subtotal_row("TOTAL DEPT.FMCG EXC UIN", [o for o in _FMCG_ALL if o != "UIN"]))
        rows.append(subtotal_row("TOTAL MBG", ["MBG"]))
    else:
        # HOLDING/ALL - gabungan semua departemen, sesuai sheet "ALL" di file
        # "SALES REPORT HO" (F&H.S exclude HCW, Total F&H.S, Fmcg exclude
        # MBG/UIN, Total FMCG, Mini Soccer, lalu 3 baris grand total).
        fashion_all = _FASHION_OFFLINE + _FASHION_ONLINE
        rows = [
            subtotal_row("F&H.S exclude HCW", [o for o in fashion_all if o != "HCW"]),
            subtotal_row("Total (F&H.S)", fashion_all),
            subtotal_row("Fmcg exclude MBG", [o for o in _FMCG_ALL if o != "MBG"]),
            subtotal_row("Fmcg exclude UIN", [o for o in _FMCG_ALL if o != "UIN"]),
            subtotal_row("Total (FMCG)", _FMCG_ALL),
            outlet_row(_MINI_SOCCER_OUTLET),
        ]
        total_exc_mbg = fashion_all + [o for o in _FMCG_ALL if o != "MBG"] + [_MINI_SOCCER_OUTLET]
        total_exc_uin_hcw = [o for o in fashion_all if o != "HCW"] + [o for o in _FMCG_ALL if o != "UIN"] + [_MINI_SOCCER_OUTLET]
        grand_total = fashion_all + _FMCG_ALL + [_MINI_SOCCER_OUTLET]
        rows.append(subtotal_row("TOTAL Exclude MBG", total_exc_mbg))
        rows.append(subtotal_row("TOTAL Exclude UIN & HCW", total_exc_uin_hcw))
        rows.append(subtotal_row("GRAND TOTAL", grand_total))

    return {
        "department": dept, "as_of_date": str(as_of), "bulan": bulan_ini,
        "standard_achieve_pct": standard_achieve_pct, "remaining_days": remaining_days, "rows": rows,
    }


# --- Ditambahkan: trend Sales Harian HOLDING (grand total semua outlet), bulan
# ini vs bulan lalu vs tahun lalu + rata-rata & target pencapaian 90%/100%.
# URL: /api/method/custom_reports.sales_api.get_holding_daily_trend?as_of_date=YYYY-MM-DD

def _daily_sales_by_date(start_date, end_date, outlets):
    if not outlets:
        return {}
    placeholders = ", ".join(["%s"] * len(outlets))
    rows = frappe.db.sql(f"""
        SELECT posting_date, SUM(grand_total - COALESCE(loyalty_amount, 0)) AS sales
        FROM `tabSales Invoice`
        WHERE docstatus = 1 AND is_return = 0
          AND posting_date BETWEEN %s AND %s
          AND custom_outlet IN ({placeholders})
        GROUP BY posting_date
    """, [start_date, end_date] + list(outlets), as_dict=True)
    return {str(r["posting_date"]): (r["sales"] or 0) for r in rows}


def _daily_kmt_mbg_by_date(start_date, end_date, include_mbg=True):
    kategori_cond = "" if include_mbg else "AND kategori = 'Kemitraan'"
    rows = frappe.db.sql(f"""
        SELECT tanggal, SUM(nominal) AS sales
        FROM `tabKemitraan MBG Sales History`
        WHERE tanggal BETWEEN %s AND %s {kategori_cond}
        GROUP BY tanggal
    """, (start_date, end_date), as_dict=True)
    return {str(r["tanggal"]): (r["sales"] or 0) for r in rows}


def _daily_mbg_only_by_date(start_date, end_date):
    """MBG SAJA, tanpa Kemitraan - dipakai khusus utk get_holding_daily_trend
    department=FMCG, yg scope-nya (divalidasi thd sheet 'Grafik Dept.') ikut
    MBG tapi TIDAK ikut Kemitraan (beda dgn get_sales_vs_target_detail yg
    'TOTAL DEPT.FMCG ALL'-nya include KEDUANYA)."""
    rows = frappe.db.sql("""
        SELECT tanggal, SUM(nominal) AS sales
        FROM `tabKemitraan MBG Sales History`
        WHERE tanggal BETWEEN %s AND %s AND kategori = 'MBG'
        GROUP BY tanggal
    """, (start_date, end_date), as_dict=True)
    return {str(r["tanggal"]): (r["sales"] or 0) for r in rows}


def _daily_skm_by_date(start_date, end_date):
    """Sub-lokasi Kemitraan 'SKM' (Sales Marketing) SAJA - khusus dipakai utk
    kolom 'Last month'/'Last year' di get_holding_daily_trend department=FMCG.
    Divalidasi thd sheet 'Master': kolom TOTAL FMCG Last month/Last year
    (AU/U) = outlet FMCG + SKM (+ MBG utk last month saja) - BEDA dgn kolom
    'current month' (AB, dari sheet 'Daily sales') yg TIDAK ikut SKM sama
    sekali. Jadi 'current' & 'last month/year' scope-nya sengaja gak sama,
    ngikutin apa adanya di file sumber."""
    rows = frappe.db.sql("""
        SELECT tanggal, SUM(nominal) AS sales
        FROM `tabKemitraan MBG Sales History`
        WHERE tanggal BETWEEN %s AND %s AND sub_kode = 'SKM'
        GROUP BY tanggal
    """, (start_date, end_date), as_dict=True)
    return {str(r["tanggal"]): (r["sales"] or 0) for r in rows}


def _daily_history_by_date(start_date, end_date, outlets):
    if not outlets:
        return {}
    placeholders = ", ".join(["%s"] * len(outlets))
    rows = frappe.db.sql(f"""
        SELECT tanggal, SUM(nominal) AS sales
        FROM `tabOutlet Daily Sales History`
        WHERE tanggal BETWEEN %s AND %s AND outlet IN ({placeholders})
        GROUP BY tanggal
    """, [start_date, end_date] + list(outlets), as_dict=True)
    return {str(r["tanggal"]): (r["sales"] or 0) for r in rows}


def _build_series(start_date, n_days, sales_by_date):
    series = []
    for i in range(n_days):
        d = frappe.utils.add_days(start_date, i)
        series.append({"day": i + 1, "date": str(d), "sales": sales_by_date.get(str(d), 0)})
    return series


@frappe.whitelist()
def get_holding_daily_trend(as_of_date=None, department=None):
    as_of = frappe.utils.getdate(as_of_date or frappe.utils.today())
    month_start = as_of.replace(day=1)
    bulan_ini = _BULAN_ID[as_of.month - 1]
    days_in_month = calendar.monthrange(as_of.year, as_of.month)[1]

    last_month_end = frappe.utils.add_days(month_start, -1)
    last_month_start = last_month_end.replace(day=1)
    last_month_days = calendar.monthrange(last_month_end.year, last_month_end.month)[1]

    last_year = as_of.year - 1
    last_year_days = calendar.monthrange(last_year, as_of.month)[1]
    last_year_month_start = frappe.utils.getdate(f"{last_year}-{as_of.month:02d}-01")
    last_year_month_end = frappe.utils.getdate(f"{last_year}-{as_of.month:02d}-{last_year_days:02d}")

    # department=None/HOLDING -> semua outlet (Fashion+FMCG+Mini Soccer+MBG).
    # department=FASHION -> outlet Fashion saja, TANPA KMT/MBG/Mini Soccer.
    # department=FMCG -> outlet FMCG ritel saja (10 toko), TANPA KMT & MBG -
    # divalidasi persis thd sheet "Grafik Dept." (kolom AB "DEPT FMCG" sama
    # persis dgn kolom "OUTLET DEPT.FMCG" di sheet "Daily sales", yg terbukti
    # TIDAK menjumlahkan Kemitraan maupun MBG sama sekali). Beda dgn
    # get_sales_vs_target_detail yg "TOTAL DEPT.FMCG ALL"-nya MEMANG include
    # KMT+MBG (scope beda, divalidasi terpisah thd sheet lain) - sengaja gak
    # disamakan.
    dept = (department or "HOLDING").upper()
    include_mbg_period = True
    if dept == "FASHION":
        outlets = list(_FASHION_OUTLETS)
        include_mbg_period = False
    elif dept == "FMCG":
        outlets = [o for o in _FMCG_OUTLETS if o != "KMT"]  # KMT ditangani lewat _sales_by_kmt_mbg, bukan Sales Invoice
        include_mbg_period = False
    else:
        outlets = _FASHION_OUTLETS + [o for o in _FMCG_OUTLETS if o != "KMT"] + [_MINI_SOCCER_OUTLET]
        include_mbg_period = True
    # XSMGROW (outlet baru, buka 8 Agustus 2026) TETAP ikut di sales & target
    # bulan berjalan (outlets), tapi di-exclude dari outlets_hist krn blm py
    # pembanding bulan lalu/tahun lalu yg adil - sama spt di get_sales_vs_target.
    outlets_hist = [o for o in outlets if o != "XSMGROW"]
    # FMCG: scope "Last month" & "Last year" beda dari di atas (divalidasi thd
    # sheet "Master") - Last month TETAP ikut XSM Grow (sudah buka sejak
    # Agustus, jadi fair dibandingkan ke September); Last year exclude XSM
    # Grow DAN UIN Grow (dua2nya belum ada di Oktober 2025).
    lm_outlets_fmcg = outlets
    ly_outlets_fmcg = [o for o in outlets if o not in ("XSMGROW", "UIN")]

    def _kmt_mbg_for_period(start_date, end_date, is_last_year=False):
        if dept == "FASHION":
            return {}
        if dept == "FMCG":
            # MBG ikut, Kemitraan TIDAK (lihat docstring _daily_mbg_only_by_date).
            # MBG blm py pembanding tahun lalu -> kosong.
            return {} if is_last_year else _daily_mbg_only_by_date(start_date, end_date)
        if is_last_year:
            return _daily_kmt_mbg_by_date(start_date, end_date, include_mbg=False)  # KMT saja, MBG blm py pembanding thn lalu
        return _daily_kmt_mbg_by_date(start_date, end_date, include_mbg=include_mbg_period)

    # Bulan ini & bulan lalu: dari Sales Invoice (live) + Kemitraan/MBG history
    cur_si = _daily_sales_by_date(month_start, as_of, outlets)
    cur_kmtmbg = _kmt_mbg_for_period(month_start, as_of)
    current_by_date = {}
    for k in set(cur_si) | set(cur_kmtmbg):
        current_by_date[k] = cur_si.get(k, 0) + cur_kmtmbg.get(k, 0)

    lm_end = last_month_start.replace(day=last_month_days)
    if dept == "FMCG":
        # "Last month" di FMCG ikut SKM (sub-lokasi Kemitraan "Sales
        # Marketing") + MBG - beda dgn "current month" yg ga ikut SKM sama
        # sekali (lihat docstring _daily_skm_by_date).
        lm_si = _daily_sales_by_date(last_month_start, lm_end, lm_outlets_fmcg)
        lm_kmtmbg = dict(_daily_skm_by_date(last_month_start, lm_end))
        for k, v in _daily_mbg_only_by_date(last_month_start, lm_end).items():
            lm_kmtmbg[k] = lm_kmtmbg.get(k, 0) + v
    else:
        lm_si = _daily_sales_by_date(last_month_start, lm_end, outlets_hist)
        lm_kmtmbg = _kmt_mbg_for_period(last_month_start, lm_end)
    last_month_by_date = {}
    for k in set(lm_si) | set(lm_kmtmbg):
        last_month_by_date[k] = lm_si.get(k, 0) + lm_kmtmbg.get(k, 0)

    # Tahun lalu: dari doctype histori (Sales Invoice blm py data sblm April
    # 2026) + Kemitraan SAJA (tanpa MBG - MBG blm py pembanding thn lalu, sama
    # spt di get_sales_vs_target/_kmt_only). Utk FMCG, "Kemitraan" di sini
    # artinya SKM saja (lihat docstring _daily_skm_by_date), bukan 4 sub-lokasi
    # lain (RSI/FDM/ANM/UMTAS) yg emang gak termasuk scope chart ini.
    if dept == "FMCG":
        ly_hist = _daily_history_by_date(last_year_month_start, last_year_month_end, ly_outlets_fmcg)
        ly_kmt = _daily_skm_by_date(last_year_month_start, last_year_month_end)
    else:
        ly_hist = _daily_history_by_date(last_year_month_start, last_year_month_end, outlets_hist)
        ly_kmt = _kmt_mbg_for_period(last_year_month_start, last_year_month_end, is_last_year=True)
    last_year_by_date = {}
    for k in set(ly_hist) | set(ly_kmt):
        last_year_by_date[k] = ly_hist.get(k, 0) + ly_kmt.get(k, 0)

    # current_month diisi PENUH sampai akhir bulan (hari setelah as_of_date =
    # 0), bukan cuma sampai as_of.day - supaya garis chart di frontend gak
    # keliatan "putus" di tengah bulan. accumulated_so_far tetap dihitung dari
    # current_by_date langsung (bukan dari current_series) jadi gak kepengaruh
    # oleh hari2 padding yg nilainya 0.
    current_series = _build_series(month_start, days_in_month, current_by_date)
    last_month_series = _build_series(last_month_start, last_month_days, last_month_by_date)
    last_year_series = _build_series(last_year_month_start, last_year_days, last_year_by_date)
    max_days = max(days_in_month, last_month_days, last_year_days)

    accumulated_so_far = sum((current_by_date.get(str(d)) or 0)
                              for d in [frappe.utils.add_days(month_start, i) for i in range(as_of.day)])
    avg_current = accumulated_so_far / as_of.day if as_of.day else 0
    # Avg "Bulan Lalu"/"Tahun Lalu" dihitung MTD (hari 1 s/d hari yg sama dgn
    # bulan berjalan), BUKAN rata-rata sebulan penuh - divalidasi thd foto
    # laporan HOLDING (avg bulan lalu MTD jauh lebih dekat ke angka foto
    # drpd avg sebulan penuh). last_month_series/last_year_series sendiri
    # tetap dikembalikan penuh 1 bulan utk keperluan chart.
    lm_mtd_days = min(as_of.day, last_month_days)
    avg_last_month = sum(d["sales"] for d in last_month_series[:lm_mtd_days]) / lm_mtd_days if lm_mtd_days else 0
    ly_mtd_days = min(as_of.day, last_year_days)
    avg_last_year = sum(d["sales"] for d in last_year_series[:ly_mtd_days]) / ly_mtd_days if ly_mtd_days else 0

    def pct_change(new, old):
        if not old:
            return None
        return round((new / old - 1) * 100, 2)

    targets = _target_by_outlet(bulan_ini)
    monthly_target = sum(targets.get(o, 0) for o in outlets)
    if dept != "FASHION":
        # KMT & MBG dikeluarkan dari `outlets` (sales-nya bukan dari Sales
        # Invoice), tapi target-nya harus tetap ikut dihitung.
        monthly_target += targets.get("KMT", 0) + targets.get(_MBG_OUTLET, 0)
    remaining_days = days_in_month - as_of.day

    req_avg_90 = None
    req_avg_100 = None
    if remaining_days > 0:
        req_avg_90 = round((monthly_target * 0.9 - accumulated_so_far) / remaining_days, 2)
        req_avg_100 = round((monthly_target - accumulated_so_far) / remaining_days, 2)

    return {
        "as_of_date": str(as_of), "bulan": bulan_ini,
        "days_in_month": days_in_month, "remaining_days": remaining_days,
        "max_days": max_days,
        "current_month": current_series,
        "last_month": last_month_series,
        "last_year": last_year_series,
        "avg_daily_sales_current": round(avg_current, 2),
        "avg_daily_sales_last_month": round(avg_last_month, 2),
        "avg_daily_sales_last_year": round(avg_last_year, 2),
        "vs_last_month_pct": pct_change(avg_current, avg_last_month),
        "vs_last_year_pct": pct_change(avg_current, avg_last_year),
        "monthly_target": monthly_target,
        "accumulated_so_far": accumulated_so_far,
        "required_avg_daily_90pct": req_avg_90,
        "required_avg_daily_100pct": req_avg_100,
    }


# --- Ditambahkan: Sales Achievement MINGGUAN (TC/Sales/AC) per outlet, per
# departemen, dan ALL/HOLDING - dibandingkan minggu sebelumnya (growth), tahun
# lalu (minggu yg sama), dan 2 bulan terakhir (minggu yg sama).
# URL: /api/method/custom_reports.sales_api.get_weekly_sales_achievement?month=8&year=2026
#
# Definisi minggu (divalidasi thd file "SALES REPORT HO AGT 2026.xlsx" sheet
# "Data weekly" - jumlah TC Week1+2+3+4 cocok persis dgn MTD):
#   Week 1 = tgl 1-7, Week 2 = tgl 8-14, Week 3 = tgl 15-21, Week 4 = tgl 22-akhir bulan.
# Selalu 4 minggu, minggu ke-4 menyerap sisa hari bulan (7-10 hari tergantung
# panjang bulan).

_WEEKLY_STARTS = [1, 8, 15, 22]


def _week_bounds(year, month):
    days_in_month = calendar.monthrange(year, month)[1]
    bounds = []
    for i, s in enumerate(_WEEKLY_STARTS):
        e = (_WEEKLY_STARTS[i + 1] - 1) if i < 3 else days_in_month
        e = min(e, days_in_month)
        bounds.append((s, e))
    return bounds


def _month_tc_sales(year, month, outlets):
    """TC & Sales per outlet, per Week1-4, utk 1 bulan tertentu. Pakai Sales
    Invoice (live) kalau bulan itu >= April 2026, kalau lebih lama pakai
    histori 'Outlet Daily Sales History'. KMT selalu dari 'Kemitraan MBG Sales
    History' (outlet ini gak pernah punya Sales Invoice) - MBG ikut kalau
    bulan itu 'current-ish' (bkn pembanding tahun lalu), krn blm py histori
    tahun lalu (program baru mulai Sept 2025)."""
    month_start = frappe.utils.getdate(f"{year}-{month:02d}-01")
    is_history = month_start < frappe.utils.getdate("2026-04-27")

    weeks = []
    for s, e in _week_bounds(year, month):
        start_date = frappe.utils.getdate(f"{year}-{month:02d}-{s:02d}")
        end_date = frappe.utils.getdate(f"{year}-{month:02d}-{e:02d}")
        src = _sales_by_outlet_history(start_date, end_date) if is_history else _sales_by_outlet(start_date, end_date)
        if is_history:
            kmtmbg = _kmt_only(start_date, end_date)
        else:
            kmtmbg = _sales_by_kmt_mbg(start_date, end_date)
        merged = dict(src)
        merged.update(kmtmbg)
        weeks.append({o: merged.get(o, {"sales": 0, "trx": 0}) for o in outlets})
    return weeks


_WEEKLY_OUTLETS = _FASHION_OUTLETS + [o for o in _FMCG_OUTLETS if o != "KMT"] + [_MINI_SOCCER_OUTLET, "KMT", _MBG_OUTLET]


def _pct(new, old):
    if not old or new is None:
        return None
    return round((new / old - 1) * 100, 2)


def _ac(sales, trx):
    return round(sales / trx, 2) if trx else None


@frappe.whitelist()
def get_weekly_sales_achievement(month=None, year=None):
    today = frappe.utils.getdate(frappe.utils.today())
    month = int(month) if month else today.month
    year = int(year) if year else today.year

    # bulan ini, 2 bulan sebelumnya, dan bulan yg sama tahun lalu (utk pembanding per-week)
    m1 = month - 1 if month > 1 else 12
    y1 = year if month > 1 else year - 1
    m2 = m1 - 1 if m1 > 1 else 12
    y2 = y1 if m1 > 1 else y1 - 1
    last_year = year - 1

    cur = _month_tc_sales(year, month, _WEEKLY_OUTLETS)
    lm1 = _month_tc_sales(y1, m1, _WEEKLY_OUTLETS)
    lm2 = _month_tc_sales(y2, m2, _WEEKLY_OUTLETS)
    ly = _month_tc_sales(last_year, month, _WEEKLY_OUTLETS)

    def week_metrics(outlet):
        weeks_out = []
        prev = None
        for i in range(4):
            c = cur[i].get(outlet, {"sales": 0, "trx": 0})
            tc, sales = c["trx"], c["sales"]
            ac = _ac(sales, tc)
            growth_tc = _pct(tc, prev["trx"]) if prev else None
            growth_sales = _pct(sales, prev["sales"]) if prev else None
            growth_ac = _pct(ac, _ac(prev["sales"], prev["trx"])) if prev else None
            ly_w = ly[i].get(outlet, {"sales": 0, "trx": 0})
            lm1_w = lm1[i].get(outlet, {"sales": 0, "trx": 0})
            lm2_w = lm2[i].get(outlet, {"sales": 0, "trx": 0})
            weeks_out.append({
                "week": i + 1, "tc": tc, "sales": sales, "ac": ac,
                "growth_tc_pct": growth_tc, "growth_sales_pct": growth_sales, "growth_ac_pct": growth_ac,
                "last_year": {"tc": ly_w["trx"], "sales": ly_w["sales"],
                              "growth_tc_pct": _pct(tc, ly_w["trx"]), "growth_sales_pct": _pct(sales, ly_w["sales"])},
                "month_minus_1": {"tc": lm1_w["trx"], "sales": lm1_w["sales"],
                                  "vs_pct_tc": _pct(tc, lm1_w["trx"]), "vs_pct_sales": _pct(sales, lm1_w["sales"])},
                "month_minus_2": {"tc": lm2_w["trx"], "sales": lm2_w["sales"],
                                  "vs_pct_tc": _pct(tc, lm2_w["trx"]), "vs_pct_sales": _pct(sales, lm2_w["sales"])},
            })
            prev = c
        mtd_tc = sum(w["tc"] for w in weeks_out)
        mtd_sales = sum(w["sales"] for w in weeks_out)
        return {
            "outlet": outlet, "label": _OUTLET_LABELS.get(outlet, outlet),
            "weeks": weeks_out,
            "mtd": {"tc": mtd_tc, "sales": mtd_sales, "ac": _ac(mtd_sales, mtd_tc)},
        }

    def group_metrics(label, outlets):
        weeks_out = []
        prev = None
        for i in range(4):
            tc = sum(cur[i].get(o, {"trx": 0})["trx"] for o in outlets)
            sales = sum(cur[i].get(o, {"sales": 0})["sales"] for o in outlets)
            ac = _ac(sales, tc)
            growth_tc = _pct(tc, prev["trx"]) if prev else None
            growth_sales = _pct(sales, prev["sales"]) if prev else None
            growth_ac = _pct(ac, _ac(prev["sales"], prev["trx"])) if prev else None
            ly_tc = sum(ly[i].get(o, {"trx": 0})["trx"] for o in outlets)
            ly_sales = sum(ly[i].get(o, {"sales": 0})["sales"] for o in outlets)
            lm1_tc = sum(lm1[i].get(o, {"trx": 0})["trx"] for o in outlets)
            lm1_sales = sum(lm1[i].get(o, {"sales": 0})["sales"] for o in outlets)
            lm2_tc = sum(lm2[i].get(o, {"trx": 0})["trx"] for o in outlets)
            lm2_sales = sum(lm2[i].get(o, {"sales": 0})["sales"] for o in outlets)
            weeks_out.append({
                "week": i + 1, "tc": tc, "sales": sales, "ac": ac,
                "growth_tc_pct": growth_tc, "growth_sales_pct": growth_sales, "growth_ac_pct": growth_ac,
                "last_year": {"tc": ly_tc, "sales": ly_sales,
                              "growth_tc_pct": _pct(tc, ly_tc), "growth_sales_pct": _pct(sales, ly_sales)},
                "month_minus_1": {"tc": lm1_tc, "sales": lm1_sales,
                                  "vs_pct_tc": _pct(tc, lm1_tc), "vs_pct_sales": _pct(sales, lm1_sales)},
                "month_minus_2": {"tc": lm2_tc, "sales": lm2_sales,
                                  "vs_pct_tc": _pct(tc, lm2_tc), "vs_pct_sales": _pct(sales, lm2_sales)},
            })
            prev = {"trx": tc, "sales": sales}
        mtd_tc = sum(w["tc"] for w in weeks_out)
        mtd_sales = sum(w["sales"] for w in weeks_out)
        return {
            "outlet": label, "label": label,
            "weeks": weeks_out,
            "mtd": {"tc": mtd_tc, "sales": mtd_sales, "ac": _ac(mtd_sales, mtd_tc)},
        }

    fashion_outlets = _FASHION_OUTLETS
    fmcg_outlets = [o for o in _FMCG_OUTLETS if o != "KMT"]

    fashion_rows = [week_metrics(o) for o in fashion_outlets]
    fashion_rows.append(group_metrics("FASHION & H S", fashion_outlets))

    fmcg_rows = [week_metrics(o) for o in fmcg_outlets]
    fmcg_rows.append(group_metrics("FMCG", fmcg_outlets))

    ho_rows = [
        week_metrics(_MINI_SOCCER_OUTLET),
        week_metrics("KMT"),
        week_metrics(_MBG_OUTLET),
    ]

    holding_outlets = _WEEKLY_OUTLETS
    holding_row = group_metrics("HOLDING", holding_outlets)

    return {
        "bulan": f"{year}-{month:02d}",
        "week_bounds": [{"week": i + 1, "start": s, "end": e} for i, (s, e) in enumerate(_week_bounds(year, month))],
        "fashion": fashion_rows,
        "fmcg": fmcg_rows,
        "ho": ho_rows,
        "holding": holding_row,
    }


